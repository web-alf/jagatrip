              <dt>🎯</dt><dd><div class="lbl">Topik</div><div class="val">Roadmap Kuliah di Luar Negeri: Dari Persiapan Hingga Lolos</div></dd>
              <dt>🎙️</dt><dd><div class="lbl">Narasumber</div><div class="val">M. Syafiq Robbani · Teknik Industri &amp; Manajemen, Cheng Shiu University, Taiwan</div></dd>
              <dt>📅</dt><dd><div class="lbl">Tanggal</div><div class="val">Jumat, 7 Agustus 2026</div></dd>
              <dt>🕢</dt><dd><div class="lbl">Waktu</div><div class="val">19.30 – 21.30 WIB</div></dd>
              <dt>💻</dt><dd><div class="lbl">Platform</div><div class="val">Zoom Meeting (link H-1 di grup)</div></dd>
