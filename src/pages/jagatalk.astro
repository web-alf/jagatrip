  <Footer jagatalk />
</BaseLayout>

<script>
  import { getUtm } from '../lib/utm';
  import { initFormGuard, lockForm, isPhoneSubmitted } from '../lib/form-guard';
  import { parseIndonesianPhone } from '../lib/phone-formatter';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('reg-form-jagatalk-premium') as HTMLFormElement | null;
    if (!form) return;
    initFormGuard(form, 'jagatalk-premium-form', '✓ Pendaftaran Anda sudah terkirim. Admin JAGATALK akan menghubungi Anda.');

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const statusEl = document.getElementById('reg-status-jagatalk-premium');
    // Admin 1: Dwita, Admin 2: Kamariya
    const admins = ['6281128506576', '628139190363'];
    const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwrwCUYnuIUCflczefMlYAHdCnOD-5PMqVEL94QTPWy6Hkds6SiOQLfyo7PZpVoqtjiZg/exec';

    function showStatus(type: 'ok' | 'err', msg: string): void {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.className = `jw-reg-status ${type}`;
      statusEl.hidden = false;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const nama = (form.querySelector('#nama') as HTMLInputElement | null)?.value.trim();
      const instansi = (form.querySelector('#instansi') as HTMLInputElement | null)?.value.trim();
      const domisili = (form.querySelector('#domisili') as HTMLInputElement | null)?.value.trim();
      const rawWa = (form.querySelector('#wa') as HTMLInputElement | null)?.value.trim();

      if (!nama || !instansi || !domisili || !rawWa) {
        showStatus('err', 'Semua field wajib diisi.');
        return;
      }

      const parsedPhone = parseIndonesianPhone(rawWa);
      const wa = parsedPhone.e164 || rawWa;
      const isDuplicate = isPhoneSubmitted('jagatalk-premium-form', wa);

      if (btn) { btn.disabled = true; btn.textContent = 'Memproses...'; }

      const selectedAdmin = admins[Math.floor(Math.random() * admins.length)];
      const greeting = isDuplicate
        ? `Hai admin JAGATALK Premium, saya ${nama} dari ${instansi} (${domisili}) sebelumnya sudah mendaftar dengan nomor ini, ingin konfirmasi langkah selanjutnya.`
        : `Hai admin JAGATALK Premium, saya ${nama} dari ${instansi} (${domisili}) telah mengisi form pendaftaran webinar JAGATALK Premium (Rp 39.000). Bagaimana langkah pembayaran selanjutnya?`;
      const waUrl = `https://wa.me/${selectedAdmin}?text=${encodeURIComponent(greeting)}`;

      try {
        await fetch(APPS_SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            _sheet: 'LP_Jagatalk_Premium',
            nama,
            instansi,
            domisili,
            wa,
            ...getUtm(),
            source: 'JAGATALK Premium Landing Page (/jagatalk)',
            timestamp: new Date().toISOString(),
          }),
        });
      } catch (err) {
        console.error('Error logging lead to Google Sheet:', err);
      }

      const win = window as any;
      if (win.fbq) {
        try { win.fbq('track', 'Lead', { content_name: 'Jagatalk Premium' }); } catch (e) { console.error('FB Pixel error:', e); }
      }

      showStatus('ok', isDuplicate ? 'Sudah terdaftar sebelumnya. Mengalihkan ke WhatsApp...' : 'Pendaftaran berhasil! Mengalihkan ke WhatsApp...');
      lockForm(form, 'jagatalk-premium-form', isDuplicate ? '✓ Anda sudah terdaftar sebelumnya.' : '✓ Pendaftaran berhasil dikirim.', wa);
      setTimeout(() => { window.location.href = waUrl; }, 500);
    });
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

  .jw{
    --orange:#E85D1F;--orange-dark:#C64A11;--orange-light:#FF8A45;--dark-blue:#1B3A6B;
    --cream:#FDF6EB;--cream-dark:#F5EAD7;--white:#fff;--black:#282828;--gray:#6E6E6E;--gray-light:#E5E5E5;
