---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import { chinaEventSchema, chinaProgram as p } from '../data/china';
---
<BaseLayout title={`${p.title} | JAGATRIP`} description={`JAGATRIP #2: misi pendidikan ke Beijing dan Hangzhou, ${p.date}.`} canonical="https://jagatrip.com/china" ogType="website" extraSchemas={[chinaEventSchema]} gtmId="GTM-NX2FVX9X" gtmId2="GTM-NR8XFKP9">
  <header class="nav"><a href="/" aria-label="JAGATRIP"><img src="/images/logo-horizontal.webp" width="2188" height="460" alt="JAGATRIP Mitra Edukasi"></a><span>EDUCATION MISSION 2026</span><a href="#form">Daftar minat</a></header>
  <main id="main">
    <section class="cover" data-reveal="hero">
      <div class="hero-deco" aria-hidden="true"><span class="deco-blob b1"></span><span class="deco-blob b2"></span><span class="deco-ring"></span></div>
      <div class="hero-content">
        <p class="folio">EDUCATION MISSION · ISSUE 02</p>
        <div class="title"><p>JAGATRIP PRESENTS</p><h1><span>Beijing</span><i>to</i><span>Hangzhou</span></h1><p class="subtitle">Kelas global untuk pemimpin pendidikan Indonesia.</p></div>
      </div>
      <a class="hero-flyer" href="/images/china/flyer-jt-china-2026.webp" target="_blank" rel="noopener" aria-label="Lihat flyer JAGATRIP #2 China">
        <img src="/images/china/flyer-jt-china-2026.webp" width="1254" height="1254" alt="Flyer JAGATRIP #2 China — Beijing & Hangzhou Education Mission" loading="eager" />
        <span class="hero-flyer-hint">LIHAT FLYER ↗</span>
      </a>
      <div class="cover-meta"><div><small>PERJALANAN</small><strong>{p.date}</strong></div><div><small>FORMAT</small><strong>2 kota · 2 expo · 3 sekolah</strong></div><a href="#form">Amankan kursi <span>↘</span></a></div>
      <div class="coordinates"><span>BJS 39.9042° N</span><i></i><span>HGH 30.2741° N</span></div>
    </section>

    <section class="thesis" data-reveal="section"><p class="chapter">00 / OPENING NOTE</p><blockquote>“Bukan tur wisata dengan tempelan agenda pendidikan.”</blockquote><div><p>Tujuh hari untuk melihat bagaimana kebijakan, teknologi, dan praktik pendidikan bertemu. Dari skala Beijing menuju energi inovasi Hangzhou.</p><p>Anda datang sebagai delegasi—untuk bertanya, membandingkan, lalu membawa pulang kemungkinan kolaborasi.</p></div></section>

    <section class="atlas" data-reveal="section">
      <header><p class="chapter">ROUTE ATLAS / 中国</p><h2>Dua kota,<br/><em>satu benang merah.</em></h2></header>
      <div class="route-line">{p.cities.map((city,i) => <article><div class="node"><span>{i+1}</span></div><p>{city.date}</p><h3>{city.name}</h3><span class="cn" aria-hidden="true">{city.cn}</span><small>{city.note}</small><ul>{city.items.map(x => <li>{x}</li>)}</ul></article>)}</div>
      <p class="rail-note">4,5 JAM MELINTASI 1.300 KM DENGAN KERETA CEPAT</p>
    </section>

    {p.expos.map((expo,i) => <section class:list={{ expo:true, paper:i===1 }} data-reveal="section">
      <div class="expo-index"><span>CHAPTER</span><strong>{expo.chapter}</strong><small>{expo.city}</small></div>
      <div class="expo-copy"><p class="chapter">EXHIBITION NOTE</p><h2>{expo.name}</h2><p class="long">{expo.longName}</p><div class="venue"><span>{expo.date}</span><span>{expo.venue}</span></div><p class="body">{expo.body}</p></div>
      <div class="stats">{expo.stats.map(([n,l]) => <div><strong>{n}</strong><span>{l}</span></div>)}</div>
    </section>)}

    <section class="access" data-reveal="section"><p class="chapter">03 / SCHOOL ACCESS</p><div class="access-title"><h2>Masuk ke<br/>sekolahnya.</h2><p>Nilai paling langka dari perjalanan ini bukan kartu masuk expo. Ini kesempatan duduk bersama pengelola sekolah, melihat fasilitas, lalu bertanya langsung tentang keputusan di balik praktik mereka.</p></div><div class="school-numbers"><div><strong>3</strong><span>sekolah<br/>kunjungan</span></div></div><ol><li>Sambutan tuan rumah</li><li>Tur fasilitas</li><li>Dialog manajemen</li><li>Dokumentasi</li><li>Pertukaran cinderamata</li></ol><blockquote>Anda datang sebagai delegasi,<br/><em>bukan turis yang kebetulan lewat.</em></blockquote></section>

    <section class="itinerary" id="itinerary" data-reveal="section"><header><p class="chapter">04 / SEVEN DAYS</p><h2>Catatan perjalanan.</h2><p>Kerangka agenda dapat menyesuaikan konfirmasi partner dan penyelenggara expo.</p></header><div class="days">{p.itinerary.map(([day,date,title,body]) => <details><summary><span>{day}</span><small>{date}</small><strong>{title}</strong><i></i></summary><p>{body}</p></details>)}</div></section>

    <section class="founder" data-reveal="section">
      <p class="chapter">EDUTRIP BERSAMA</p>
      <div class="founder-card">
        <div class="founder-photo"><img src={p.founder.photo} width="500" height="500" alt={`${p.founder.name} — ${p.founder.role}`} loading="lazy" /></div>
        <div class="founder-body">
          <p class="founder-headline">{p.founder.headline}</p>
          <p class="founder-name">{p.founder.name}</p>
          <p class="founder-role">{p.founder.role} · Founder & pemimpin program edu-tourism JAGATRIP</p>
          <ul>{p.founder.points.map(pt => <li><span class="fp-icon" aria-hidden="true">{pt.icon}</span><span>{pt.text}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="fit" data-reveal="section"><div><p class="chapter">05 / WHO SHOULD JOIN</p><h2>Untuk mereka yang memimpin perubahan.</h2></div><ul>{p.audience.map((x,i) => <li><span>0{i+1}</span>{x}</li>)}</ul><aside><strong>CATATAN PENTING</strong><p>Agenda dimulai pagi dan sebagian besar waktu berada di sekolah serta ruang pameran. Program ini dirancang untuk belajar dan membangun jaringan, bukan berbelanja.</p></aside></section>

    <section class="packages" id="pricing" data-reveal="section"><header><p class="chapter">06 / DEPARTURE OPTIONS</p><h2>Dua cara berangkat.<br/><em>Satu pengalaman utuh.</em></h2></header>
      <div>{p.packages.map((pkg,i) => <article><span>OPTION 0{i+1}</span><h3>{pkg.name}</h3><p class="price">{pkg.price}</p><p>{pkg.tagline}</p><ul class="facilities">{pkg.facilities.map(([label,ok]) => <li class={ok ? 'ok' : 'no'}>{ok ? '✓' : '✕'} {label}</li>)}</ul><a href="#form">Minta rincian biaya ↗</a></article>)}</div>
      <p class="visa-note">⚠ {p.visaNote}</p>
      <a href="/chinask" class="snk-btn" target="_blank" rel="noopener">📋 S&K Jagatrip China ↗</a>
    </section>

    <section class="faq" id="faq" data-reveal="section"><header><p class="chapter">07 / QUESTIONS</p><h2>Sebelum<br/>berangkat.</h2></header><div>{p.faqs.map(([q,a]) => <details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></section>

    <section class="closing" id="form" data-reveal="section"><a id="daftar" class="anchor-offset" aria-hidden="true"></a>
      <div class="closing-head">
        <p class="chapter">FINAL NOTE / YOUR MOVE</p>
        <h2>The next class<br/>is in <em>China.</em></h2>
        <p class="closing-sub">Isi data minat. WhatsApp akan terbuka dengan pesan siap kirim ke admin JAGATRIP.</p>
      </div>
      <form data-china-form class="closing-form">
        <label><span>01</span> Nama lengkap<input name="nama" required minlength="3" autocomplete="name"></label>
        <label><span>02</span> Asal lembaga / domisili<input name="asal" required minlength="2" autocomplete="organization"></label>
        <label><span>03</span> Nomor WhatsApp<input name="whatsapp" type="tel" required pattern="[0-9+() -]{8,20}" inputmode="tel" autocomplete="tel"></label>
        <button>Kirim minat <span>↗</span></button>
        <small>Tidak mengikat pembayaran. Data hanya diteruskan lewat pesan yang Anda kirim.</small>
      </form>
      <p class="closing-cta-hint">Punya pertanyaan sebelum daftar? <a href="https://wa.me/628139190363" target="_blank" rel="noopener">Chat admin via WhatsApp ↗</a></p>
    </section>
  </main>
  <Footer />
  <script>
    import { getUtm } from '../lib/utm';
    import { initFormGuard, lockForm, isPhoneSubmitted } from '../lib/form-guard';
    import { parseIndonesianPhone } from '../lib/phone-formatter';
    const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwrwCUYnuIUCflczefMlYAHdCnOD-5PMqVEL94QTPWy6Hkds6SiOQLfyo7PZpVoqtjiZg/exec';
    const cform=document.querySelector<HTMLFormElement>('[data-china-form]');
    if(cform){initFormGuard(cform,'china-form','✓ Data Anda sudah terkirim. Tim JAGATRIP akan menghubungi Anda.');
    cform.addEventListener('submit',event=>{
      event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!form.reportValidity())return;
      const d=new FormData(form),nama=String(d.get('nama')).trim(),asal=String(d.get('asal')).trim(),rawWa=String(d.get('whatsapp')).trim();
      const parsedPhone = parseIndonesianPhone(rawWa);
      const wa = parsedPhone.e164 || rawWa;
      const isDuplicate = isPhoneSubmitted('china-form', wa);
      fetch(APPS_SCRIPT_URL,{method:'POST',mode:'no-cors',body:JSON.stringify({_sheet:'China',nama,asal,wa,...getUtm(),timestamp:new Date().toISOString(),source:window.location.href})}).catch(()=>{});
      if(typeof (window as any).fbq==='function')(window as any).fbq('track','Lead',{content_name:'China'});
      const message=isDuplicate
        ? `Halo Admin, saya ${nama} dari ${asal} sebelumnya sudah mendaftar Jagatrip ke China dengan nomor ini, ingin konfirmasi kelanjutan pendaftaran.`
        : `Halo Admin, saya ${nama} dari ${asal} tertarik ikut Jagatrip ke China dan sudah mengisi form. Nomor WhatsApp saya ${parsedPhone.display || wa}. Bagaimana selanjutnya?`;
      const cs=['628139190363','6281128506576'],nomor=cs[Math.floor(Math.random()*cs.length)];
      lockForm(form,'china-form', isDuplicate ? '✓ Anda sudah terdaftar sebelumnya. Mengalihkan ke WhatsApp...' : '✓ Data Anda sudah terkirim. Mengalihkan ke WhatsApp...', wa);
      setTimeout(()=>{location.href=`https://wa.me/${nomor}?text=${encodeURIComponent(message)}`;},300);
    })}</script>
</BaseLayout>
<style>
  :global(body){margin:0;background:#f4eee5;color:#191512;font-family:Outfit,ui-sans-serif,sans-serif}:global(*){box-sizing:border-box}.nav{height:76px;padding:0 max(24px,calc((100vw - 1240px)/2));display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:2px solid #FF6B36;position:sticky;top:0;background:rgba(244,238,229,.94);backdrop-filter:blur(12px);z-index:30}.nav img{width:165px;height:auto;display:block}.nav>span{font-size:10px;letter-spacing:.2em}.nav>a:last-child{justify-self:end;color:#191512;text-transform:uppercase;font-size:11px;font-weight:800;letter-spacing:.12em;text-underline-offset:6px}
  .cover{min-height:calc(92svh - 76px);padding:48px max(24px,calc((100vw - 1240px)/2)) 32px;position:relative;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto 1fr auto;gap:24px 48px;align-items:stretch;overflow:hidden}.hero-deco{position:absolute;inset:0;pointer-events:none;z-index:0}.deco-blob{position:absolute;border-radius:50%;filter:blur(8px);opacity:.7}.deco-blob.b1{width:180px;height:180px;background:#ff5b09;left:-40px;bottom:18%;opacity:.12}.deco-blob.b2{width:90px;height:90px;background:#c2410c;right:38%;top:14%;opacity:.16}.deco-ring{position:absolute;width:120px;height:120px;border:1px solid #ff5b09;border-radius:50%;right:42%;bottom:6%;opacity:.22}.folio,.chapter{font-size:10px;font-weight:800;letter-spacing:.19em;text-transform:uppercase;color:#a2431e}.hero-content{grid-column:1;grid-row:1/3;display:flex;flex-direction:column;text-align:left;min-width:0;justify-content:center}.hero-content .folio{margin-bottom:32px}.title{position:relative;z-index:2;margin:auto 0;text-align:left}.title>p:first-child{font-size:11px;letter-spacing:.3em;margin-bottom:14px}.title h1{font:700 clamp(44px,6vw,72px)/.9 Georgia,serif;letter-spacing:-.075em;margin:0;text-transform:uppercase}.title h1 span{display:block}.title h1 span:last-child{margin-left:0}.title h1 i{display:block;font-size:.22em;line-height:1;margin:10px 0 0 0;color:#ff5b09;text-transform:none;font-weight:400}.subtitle{font:italic clamp(14px,1.4vw,18px) Georgia,serif;margin:18px 0 0 0;max-width:460px;line-height:1.4;text-align:left}.cover-meta{grid-column:1/-1;grid-row:3;z-index:2;display:grid;grid-template-columns:1fr 1fr auto;gap:30px;border-top:1px solid #aca297;padding-top:20px;align-items:end;width:100%}.cover-meta small{display:block;font-size:9px;letter-spacing:.18em;color:#857a70}.cover-meta strong{display:block;margin-top:6px;font-size:14px}.cover-meta a{background:#191512;color:white;padding:17px 20px;text-decoration:none;font-weight:800;min-width:190px;display:flex;justify-content:space-between}.coordinates{grid-column:1/-1;grid-row:4;display:flex;align-items:center;gap:12px;font-size:8px;letter-spacing:.18em;margin-top:4px}.coordinates i{height:1px;width:40px;background:#bcb2a6}
  .hero-flyer{grid-column:2;grid-row:1/3;align-self:start;margin-top:-12px;position:relative;display:block;width:min(32vw,400px);aspect-ratio:1;overflow:hidden;box-shadow:18px 18px 0 #191512;transition:transform .35s cubic-bezier(.22,1,.36,1),box-shadow .35s ease;border:1px solid #cec5b9}.hero-flyer img{display:block;width:100%;height:100%;object-fit:cover}.hero-flyer-hint{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);font:800 9px/1 Outfit,sans-serif;letter-spacing:.2em;color:#fff;background:rgba(25,21,18,.62);padding:8px 12px;border-radius:999px;white-space:nowrap;backdrop-filter:blur(4px)}.hero-flyer:hover{transform:translate(-4px,-4px);box-shadow:22px 22px 0 #ff5b09}
  .thesis{padding:32px max(24px,calc((100vw - 1040px)/2));display:grid;grid-template-columns:.6fr 1.4fr;gap:36px}.thesis .chapter{grid-column:1/-1}.thesis blockquote{font:italic clamp(30px,3.6vw,44px)/1.15 Georgia,serif;margin:0;color:#c2410c}.thesis>div{font-size:18px;line-height:1.75;color:#655b53}
  .atlas{background:#191512;color:white;padding:36px max(24px,calc((100vw - 1140px)/2))}.atlas header{display:grid;grid-template-columns:1fr 1.5fr;align-items:start}.atlas h2,.access h2,.itinerary h2,.fit h2,.packages h2,.faq h2,.founder h2{font:700 clamp(40px,5vw,64px)/1 Georgia,serif;letter-spacing:-.055em;margin:0}.atlas h2 em,.packages h2 em{font-weight:400;color:#ff5b09}.route-line{display:grid;grid-template-columns:1fr 1fr;margin-top:40px;position:relative}.route-line::before{content:'';position:absolute;left:10px;right:10px;top:13px;height:1px;background:#71665d}.route-line article{position:relative}.route-line article:last-child{padding-left:25%}.node{width:27px;height:27px;border:1px solid #ff5b09;background:#191512;border-radius:50%;display:grid;place-items:center;position:relative;z-index:2}.node span{font-size:9px;color:#ff5b09}.route-line article>p{font-size:10px;letter-spacing:.16em;color:#968b82;margin-top:25px}.route-line h3{font:56px Georgia,serif;margin:8px 0}.route-line .cn{font:24px Georgia,serif;color:#ff5b09}.route-line small{display:block;color:#c3b8af;margin:10px 0 25px}.route-line ul{list-style:none;padding:0;color:#a99e95}.route-line li{padding:6px 0}.route-line li::before{content:'—';color:#ff5b09;margin-right:10px}.rail-note{text-align:center;border-top:1px solid #50463f;padding-top:18px;margin:30px 0 0;font-size:9px;letter-spacing:.25em;color:#b88b35}
  .expo{padding:36px max(24px,calc((100vw - 1140px)/2));display:grid;grid-template-columns:.45fr 1.1fr .8fr;gap:40px;background:#c2410c;color:white}.expo.paper{background:#fbf8f3;color:#191512}.expo-index{border-right:1px solid rgba(255,255,255,.3);display:flex;flex-direction:column}.paper .expo-index{border-color:#cec4b8}.expo-index span,.expo-index small{font-size:9px;letter-spacing:.2em}.expo-index strong{font:110px Georgia,serif;line-height:1;margin:30px 0}.expo-copy h2{font:700 clamp(50px,7vw,84px)/.95 Georgia,serif;letter-spacing:-.055em;margin:30px 0 12px}.expo-copy .long{font:italic 19px Georgia,serif;color:#f2cdbd}.paper .long{color:#c2410c}.venue{display:flex;flex-wrap:wrap;gap:10px 24px;border-block:1px solid rgba(255,255,255,.3);padding:16px 0;margin:30px 0;font-size:11px;letter-spacing:.08em}.paper .venue{border-color:#cec4b8}.expo-copy .body{font-size:17px;line-height:1.7;max-width:620px}.stats{align-self:end}.stats div{border-top:1px solid rgba(255,255,255,.3);padding:20px 0}.paper .stats div{border-color:#cec4b8}.stats strong{display:block;font:40px Georgia,serif}.stats span{font-size:11px;color:#eed8cf}.paper .stats span{color:#70665e}
  .access{padding:36px max(24px,calc((100vw - 1140px)/2));background:#f4eee5}.access-title{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin:22px 0 36px}.access-title p{font-size:18px;line-height:1.75;color:#655b53}.school-numbers{display:grid;grid-template-columns:1fr;border-block:1px solid #c7bdb2;padding:0;width:fit-content;margin-inline:auto}.school-numbers div{display:flex;align-items:center;gap:24px;padding:24px 40px}.school-numbers strong{font:84px Georgia,serif;color:#ff5b09;line-height:1}.school-numbers span{font-size:12px;text-transform:uppercase;letter-spacing:.14em}.access ol{display:grid;grid-template-columns:repeat(5,1fr);list-style-position:inside;padding:0;margin:50px 0;color:#554c45}.access li{padding:15px;border-left:1px solid #c7bdb2;font-size:12px}.access blockquote{text-align:center;font:44px/1.2 Georgia,serif;margin:40px 0 0}.access blockquote em{color:#c2410c}
  .itinerary{padding:36px max(24px,calc((100vw - 1140px)/2));background:#fbf8f3;display:grid;grid-template-columns:.8fr 1.2fr;gap:40px}.itinerary header>p:last-child{color:#756a62;line-height:1.6}.days{border-top:1px solid #c9bfb4}.days details{border-bottom:1px solid #c9bfb4}.days summary{list-style:none;display:grid;grid-template-columns:35px 90px 1fr 20px;align-items:center;gap:15px;padding:20px 0;cursor:pointer}.days summary::-webkit-details-marker{display:none}.days summary>span{color:#ff5b09;font-weight:800}.days summary small{color:#7b7067}.days summary strong{font-size:16px}.days summary i::after{content:'+';font-style:normal;color:#ff5b09}.days details[open] i::after{content:'−'}.days details p{margin:0;padding:0 20px 20px 140px;color:#6c625a;line-height:1.65}
  .founder{padding:36px max(24px,calc((100vw - 1140px)/2));background:#191512;color:#fff}.founder .chapter{color:#c99a35;margin-bottom:22px}.founder-card{display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px}.founder-photo{order:1}.founder-photo img{width:240px;height:240px;aspect-ratio:1;object-fit:cover;border-radius:50%;filter:grayscale(.15);display:block;margin:0 auto}.founder-body{order:2;max-width:760px}.founder-headline{font:italic clamp(22px,2.6vw,32px)/1.3 Georgia,serif;color:#fff;margin:0 0 28px}.founder-name{font:700 clamp(36px,5vw,58px)/1 Georgia,serif;letter-spacing:-.03em;margin:0;color:#fff}.founder-role{font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:#ff5b09;margin:10px 0 24px}.founder-body ul{list-style:none;padding:0;margin:0;border-top:1px solid #3a322d;text-align:left}.founder-body li{padding:14px 0 14px 44px;border-bottom:1px solid #3a322d;color:#c4b9b0;line-height:1.6;font-size:15px;position:relative}.founder-body .fp-icon{position:absolute;left:0;top:14px;font-size:20px;line-height:1}.founder-body li::before{content:none}
