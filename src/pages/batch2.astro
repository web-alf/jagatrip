---
import BaseLayout from '../layouts/BaseLayout.astro';

// ── Data itinerary Benchmarking Sekolah ASEAN (19–23 Okt 2026) ──
const days = [
  { n: '01', d: 'Day 1', h: 'Jakarta → Kuala Lumpur', p: 'Tiba, orientasi kota, lalu Sesi Pembukaan malam hari: kerangka enam dimensi, kartu observasi, target pribadi tiap peserta.', tags: ['Pembekalan 90 Menit'] },
  { n: '02', d: 'Day 2', h: 'Dua sekolah Malaysia', p: 'Pagi: sekolah dengan keunggulan tata kelola. Sore: sekolah dengan keunggulan kurikulum dan PPDB.', tags: ['Institusi 01', 'Institusi 02'], k: true },
  { n: '03', d: 'Day 3', h: 'Perjalanan ke Hat Yai', p: 'Rombongan bergerak lintas negara menuju Hat Yai.', tags: ['Lintas Perbatasan'], k: true },
  { n: '04', d: 'Day 4', h: 'Sekolah Hatyai & Penutupan', p: 'Kunjungan institusi keempat di Hat Yai, dilanjutkan eksplorasi kawasan. Penutupan resmi: sertifikat dan foto delegasi.', tags: ['Institusi 04', 'Penutupan & Sertifikat'], k: true },
  { n: '05', d: 'Day 5', h: 'Hat Yai → Jakarta', p: 'Perjalanan kepulangan ke Jakarta.', tags: ['Kepulangan Jakarta'] },
];

const dims = [
  { n: '01', h: 'Tata Kelola', p: 'Siapa memutuskan apa. Penjaminan mutu yang berjalan mingguan, bukan tahunan.' },
  { n: '02', h: 'Kurikulum', p: 'Dari kerangka ke ruang kelas. Asesmen, dan cara menangani siswa yang tidak seragam.' },
  { n: '03', h: 'Guru', p: 'Rekrutmen, induksi, supervisi, jenjang karier. Dan alasan mereka bertahan.' },
  { n: '04', h: 'Kultur', p: 'Disiplin yang ditegakkan tanpa drama. Peran siswa. Kemitraan orang tua.' },
  { n: '05', h: 'Sarana', p: 'Bukan seberapa mewah. Seberapa sering dipakai — dan untuk apa.' },
  { n: '06', h: 'PPDB', p: 'Cara mereka menjaga keterisian tanpa perang harga. Jarang dibahas, paling dibutuhkan.' },
];

const problems = [
  { b: '01', p: 'Kurikulum berubah lagi.', s: 'Tenaga habis mengejar format. Sistem internal tak pernah sempat dibangun.' },
  { b: '02', p: 'Mutu jadi berkas, bukan kebiasaan.', s: 'Disiapkan menjelang visitasi, lalu kembali ke laci.' },
  { b: '03', p: 'Guru dilatih, lalu pindah.', s: 'Sekolah lain menahan gurunya. Caranya bisa ditiru.' },
  { b: '04', p: 'PPDB dimenangkan diskon.', s: 'Karena pembeda mutu tak pernah dibuktikan ke orang tua.' },
  { b: '05', p: 'Standar “baik” berhenti di sekolah sebelah.', s: 'Tanpa pembanding lintas negara, jaraknya tak pernah terukur.' },
  { b: '06', p: 'Studi banding pulang bawa foto.', s: 'Tanpa instrumen, kunjungan berhenti jadi kekaguman.' },
];

const outs = [
  { b: 'I', h: 'Laporan Studi Lapangan', p: 'Temuan terstruktur per dimensi. Siap dilampirkan ke pertanggungjawaban yayasan atau dinas.' },
  { b: 'II', h: 'Rencana Aksi 90 Hari', p: 'Sasaran, indikator, penanggung jawab, tenggat. Disusun sebelum pulang, bukan dijanjikan.' },
  { b: 'III', h: 'Sertifikat', p: 'Ditandatangani Jagatrip bersama institusi tuan rumah.' },
  { b: 'IV', h: 'Dokumentasi Profesional', p: 'Foto dan video resmi, satu folder per peserta. Siap jadi materi komunikasi sekolah.' },
  { b: 'V', h: 'Fasilitas Kerjasama Lanjutan', p: 'Pertemuan 1 hari pasca kunjungan melalui media online. 1 institusi per 1x pertemuan.' },
  { b: 'VI', h: 'Jalur Kerja Sama', p: 'Fasilitas akses kerjasama dengan sekolah kunjungan.' },
  { b: 'VII', h: 'Jejaring Alumni', p: 'Grup lintas provinsi berisi pemimpin sekolah yang mengerjakan masalah yang sama.' },
];

const who = [
  'Guru & pendidik yang diutus sekolah',
  'Kepala & wakil kepala sekolah',
  'Ketua & pengurus yayasan',
  'Kabid kurikulum & kesiswaan',
  'Tim penjaminan mutu sekolah',
  'Pengawas & pembina satuan pendidikan',
];

const proto = [
  'Penyambutan, foto delegasi, presentasi profil tuan rumah',
  'Presentasi profil delegasi Indonesia oleh juru bicara',
  'Observasi kelas dalam kelompok kecil',
  'Tur fasilitas — dengan pertanyaan soal tingkat pemanfaatannya',
  'Dialog terarah, cinderamata, penandatanganan LoI',
];

const pkgCommon = [
  'Bus pariwisata VIP selama seluruh program',
  'Hotel 4 malam, setara bintang 3',
  'Makan sesuai program, seluruhnya halal',
  'Perizinan & koordinasi 4 institusi',
  'Tour leader & pemandu lokal',
  'Instrumen observasi & pembekalan daring',
  'Sertifikat & laporan studi lapangan resmi',
  'Dokumentasi foto & video',
  'Asuransi perjalanan',
];

const faqs = [
  ['Sekolah mana saja yang dikunjungi?', 'Tiga sekolah di Malaysia dan satu di Hatyai. Nama dan profil lengkapnya diumumkan ke seluruh pendaftar pada 8 September 2026, setelah semua konfirmasi tertulis masuk. Kalau daftarnya dinilai tidak sesuai, uang muka kembali penuh.'],
  ['Bagaimana cara mengamankan kursi?', 'Uang muka Rp 2.500.000 per peserta. Dapat dikembalikan penuh hingga 18 September 2026. Pelunasan paling lambat 5 Oktober 2026.'],
  ['Perlu bisa bahasa Melayu atau Thai?', 'Tidak. Di Malaysia bahasa pengantarnya bisa dipahami langsung. Di Hat Yai komunikasi berlangsung dalam bahasa Inggris, materi kedua pihak disiapkan dua bahasa, dan tim Jagatrip mendampingi sepanjang sesi.'],
  ['Saya guru, bukan pemegang keputusan. Apakah tetap sesuai?', 'Sesuai — dan justru banyak sekolah memilih jalur ini. Peserta pulang membawa laporan dan Rencana Aksi 90 Hari yang siap dipresentasikan kepada kepala sekolah atau yayasan, lengkap dengan paket diseminasi untuk sesi berbagi ke rekan guru lainnya.'],
  ['Apakah laporannya bisa dipakai untuk pertanggungjawaban?', 'Ya — itu justru rancangannya. Peserta pulang membawa Laporan Studi Lapangan berkop resmi, Rencana Aksi 90 Hari, sertifikat, dan dokumentasi. Kami juga meminta surat tugas dari sekolah asal agar status perjalanannya jelas sejak awal.'],
  ['Bagaimana ketersediaan makanan halal?', 'Seluruh rumah makan dipastikan halal, termasuk di leg Hatyai. Alergi dan pantangan didata sebelum keberangkatan dan diteruskan ke penyedia konsumsi.'],
  ['Bisakah sekolah mengirim lebih dari satu orang?', 'Sangat disarankan. Perubahan lebih mudah dijalankan bila yang melihat langsung lebih dari satu kepala. Skema keberangkatan kolektif dibahas bersama tim program.'],
  ['Bagaimana jika kuota penuh?', 'Pendaftar berikutnya masuk daftar tunggu dan mendapat prioritas untuk angkatan berikutnya. Formulir minat tidak mengikat kewajiban pembayaran.'],
];
---

<BaseLayout
  title="Benchmarking Sekolah ASEAN — Malaysia & Thailand | JAGATRIP"
  description="Benchmarking & Sinergi dengan Sekolah Malaysia Thailand: dari Ruang Kelas Malaysia ke Hatyai. Program studi lapangan terstruktur bagi pimpinan satuan pendidikan Indonesia."
  canonical="https://jagatrip.com/batch2"
  ogType="website"
>
  <div class="b2" id="main">
    <!-- TOPBAR -->
    <div class="topbar">
      <div class="wrap tb">
        <a href="#top" class="brand" aria-label="JAGATRIP">
          <img src="/images/batch2/logo-logogram.png" alt="" width="702" height="764" class="bm-img" aria-hidden="true" />
          <img src="/images/batch2/logo-logotype.png" alt="JAGATRIP" width="2094" height="570" class="bn-img" />
        </a>
        <nav class="tb-nav" aria-label="Navigasi utama">
          <a href="#metode">Metode</a>
          <a href="#hari">Itinerary</a>
          <a href="#pemandu">Pemandu</a>
          <a href="#harga">Harga</a>
          <a href="#daftar" class="tb-cta">Daftar Minat</a>
        </nav>
      </div>
    </div>

    <!-- HERO -->
    <header class="hero grid-bg" id="top">
      <div class="wrap hero-in">
        <div>
          <div class="kick"><i></i> Education Mission · Oktober 2026</div>
          <h1>Benchmarking &amp; Sinergi<br />dengan <span class="hl">Sekolah Malaysia Thailand</span><span class="kick2">dari Ruang Kelas Malaysia ke Hatyai.</span></h1>
          <div class="theme-strip">
            <span class="a">Benchmarking Sekolah ASEAN</span>
            <span class="b">Dari ruang kelas Malaysia ke Hatyai</span>
          </div>
          <div class="route">
            <div class="r">Kuala Lumpur <i>→</i> Hat Yai</div>
            <div class="dt">19–23 OKTOBER 2026</div>
          </div>
          <p class="hero-p">Program studi lapangan terstruktur bagi pimpinan satuan pendidikan Indonesia. <b>Lima hari, empat institusi, dua negara</b> — dengan instrumen observasi baku, laporan resmi yang dapat dipertanggungjawabkan, serta akses untuk kerjasama dengan sekolah kunjungan.</p>
          <div class="proof">
            <div><b>04</b><span>Institusi</span></div>
            <div><b>02</b><span>Negara</span></div>
            <div><b>05</b><span>Hari</span></div>
            <div><b>06</b><span>Dimensi Observasi</span></div>
          </div>
          <div class="hero-btns">
            <a href="#daftar" class="btn b-o">Amankan Kursi</a>
            <a href="#metode" class="btn b-n">Lihat Metode ↘</a>
          </div>
        </div>
        <div>
          <div class="flyer">
            <img src="/images/batch2/flyer-hero.avif" alt="Flyer Program Benchmarking Sekolah ASEAN — Malaysia &amp; Thailand" class="flyer-img" width="1080" height="1440" />
          </div>
        </div>
      </div>

      <div class="mbar">
        <div class="wrap"><div class="mbar-in">
          <div class="mb"><div class="k">Perjalanan</div><div class="v">19–23 Okt 2026</div></div>
          <div class="mb"><div class="k">Format</div><div class="v">2 negara · <span>4 institusi</span></div></div>
          <div class="mb"><div class="k">Rute</div><div class="v">KL · Hatyai</div></div>
          <div class="mb"><div class="k">Kuota</div><div class="v">Terbatas</div></div>
        </div></div>
      </div>
    </header>

    <!-- 00 OPENING NOTE -->
    <section class="dark grid-bg-d">
      <div class="wrap">
        <div class="idx dk rv">00 / Opening Note</div>
        <p class="quote rv">“Sekolah Anda tidak kekurangan pelatihan.<br />Yang kurang <em>pembanding</em>.”</p>
        <div class="plist rv">
          {problems.map((x) => <div class="pl"><b>{x.b}</b><p>{x.p}</p><small>{x.s}</small></div>)}
        </div>
        <div class="verdict rv">
          <p>Enam-enamnya tidak selesai di ruang seminar.<br />Selesainya di ruang kelas orang lain.</p>
        </div>
      </div>
    </section>

    <!-- 01 METODE -->
    <section class="grid-bg" id="metode">
      <div class="wrap">
        <div class="m-head">
          <div class="rv">
            <div class="idx">01 / Method</div>
            <h2 class="sec-t">Enam dimensi.<br />Empat institusi.<br />Satu kerangka.</h2>
          </div>
          <p class="m-note rv">Semua peserta mengamati dimensi yang sama di setiap sekolah. Karena itu hasilnya bisa dibandingkan — bukan sekadar dikumpulkan.</p>
        </div>
        <div class="dims rv">
          {dims.map((x) => <div class="dim"><div class="n">{x.n}</div><h4>{x.h}</h4><p>{x.p}</p></div>)}
        </div>
        <div class="card4 rv">
          <div class="c4-l"><b>Kartu Observasi</b><span>Diisi di lokasi</span></div>
          <div class="c4"><i>Kolom 1</i>Apa yang saya lihat</div>
          <div class="c4"><i>Kolom 2</i>Bagaimana mereka melakukannya</div>
          <div class="c4"><i>Kolom 3</i>Kondisi di sekolah saya</div>
          <div class="c4"><i>Kolom 4</i>Bisa diadopsi? Ya / Ubah / Tidak — sebutkan alasannya</div>
        </div>
        <p class="rv c4-note">Kolom keempat adalah inti programnya. Tanpa itu, kunjungan berhenti jadi kekaguman.</p>
      </div>
    </section>

    <!-- 02 SCHOOL ACCESS -->
    <section class="dark grid-bg-d">
      <div class="wrap">
        <div class="idx dk rv">02 / School Access</div>
        <div class="sa">
          <div class="rv">
            <h2 class="sec-t">Masuk ke<br />sekolahnya.</h2>
            <p class="sa-p rv">Tiga sekolah di Malaysia, satu di Hatyai. Duduk bersama pengelolanya, masuk kelasnya, lalu bertanya soal keputusan di balik praktik mereka.</p>
            <div class="sa-stats">
              <div class="sst"><b>04</b><span>institusi</span></div>
              <div class="sst"><b>02</b><span>negara</span></div>
              <div class="sst"><b>05</b><span>hari</span></div>
            </div>
            <p class="pull">Anda datang sebagai <em>delegasi</em> — bukan rombongan yang kebetulan lewat.</p>
          </div>
          <div class="proto rv">
            <div class="ph">Protokol kunjungan · berlaku di setiap institusi</div>
            {proto.map((x, i) => <div class="pr"><div class="t">0{i + 1}</div><div class="x">{x}</div></div>)}
          </div>
        </div>
      </div>
    </section>

    <!-- 03 LIMA HARI -->
    <section class="cream" id="hari">
      <div class="wrap">
        <div class="idx rv">03 / Five Days</div>
        <h2 class="sec-t rv">Catatan perjalanan.</h2>
        <p class="rv sec-p">Empat malam hotel. Satu bus pariwisata untuk seluruh rombongan, dari hari pertama sampai terakhir.</p>
        <div class="rv">
          {days.map((day) => (
            <div class="day">
              <div class="n">{day.n}</div>
              <div class="d">{day.d}</div>
              <div class="db">
                <h4>{day.h}</h4>
                <p>{day.p}</p>
                <div class="tags">{day.tags.map((t) => <span class:list={['tg', { k: day.k }]}>{t}</span>)}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 TRIP LEADER -->
    <section class="dark grid-bg-d" id="pemandu">
      <div class="wrap">
        <div class="idx dk rv">04 / Trip Leader</div>
        <h2 class="sec-t rv">Dipandu orang yang<br />sudah melakukannya.</h2>
        <p class="rv lead-p">Bukan sekadar perjalanan bersama — belajar langsung dari yang sudah menempuh jalannya.</p>
        <div class="lead-in rv">
          <div class="lead-card">
            <div class="ph-img lead-photo-wrap">
              <img src="/Dedi Gunawan.jpeg" alt="Mr. Dedi Gunawan — CEO &amp; Founder JAGATRIP" class="lead-photo" width="1000" height="1250" />
            </div>
            <div class="lead-id">
              <b>Mr. Dedi Gunawan</b>
              <span>CEO &amp; Founder JAGATRIP · Pemandu Perjalanan</span>
            </div>
            <div class="lead-badges">
              <span>30+ Negara</span>
              <span>Edutrip Terstruktur</span>
              <span>Riset Lapangan</span>
            </div>
          </div>
          <div class="lead-pts">
            <div class="lp">
              <b>01</b>
              <p>Telah menjejakkan kaki di 30+ negara di Asia, Afrika &amp; Eropa — bukan sekadar jalan-jalan, tapi membawa pulang ilmu nyata tentang sistem pendidikan dunia.</p>
            </div>
            <div class="lp">
              <b>02</b>
              <p>Menggagas program backpacker edukatif lintas negara — dari 2 negara hingga 30 negara dalam satu perjalanan. Belajar sambil menjelajah, bukan pilih salah satu.</p>
            </div>
            <div class="lp">
              <b>03</b>
              <p>Berpengalaman mendampingi kepala sekolah, guru &amp; praktisi pendidikan dalam study visit ke institusi pendidikan mancanegara di Jepang, China, Korea, Taiwan, hingga Timur Tengah.</p>
            </div>
            <div class="lp">
              <b>04</b>
              <p>Aktif melakukan benchmarking langsung ke sekolah &amp; kampus internasional di Asia Timur &amp; Timur Tengah — riset lapangan yang jadi pondasi setiap program JAGATRIP.</p>
            </div>
            <div class="lp">
              <b>05</b>
              <p>Memiliki rekam jejak pendampingan program studi Islam internasional di Malaysia, Madinah &amp; Cairo — menggabungkan wawasan global dengan nilai-nilai pendidikan Islam.</p>
            </div>
            <div class="lp">
              <b>06</b>
              <p>Telah mengkoordinasikan puluhan peserta per program — pelajar, guru, hingga pengelola sekolah — dengan manajemen perjalanan yang terstruktur &amp; tujuan pembelajaran yang jelas.</p>
            </div>
            <div class="lp full">
              <b>07</b>
              <p>Setiap destinasi dipilih berdasarkan observasi &amp; riset mendalam, bukan tren — sehingga setiap edutrip punya dampak nyata bagi pengembangan institusi pendidikan di Indonesia.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 TAKE HOME -->
    <section class="grid-bg">
      <div class="wrap">
        <div class="idx rv">05 / Take Home</div>
        <h2 class="sec-t rv">Pulang bawa dokumen,<br />bukan oleh-oleh.</h2>
        <p class="rv sec-p wide">Hambatan terbesar biasanya bukan “mau atau tidak”, tapi “bagaimana melaporkannya”. Semua di bawah ini menjawab itu.</p>
        <div class="outs rv">
          {outs.map((x) => <div class="ou"><b>{x.b}</b><h4>{x.h}</h4><p>{x.p}</p></div>)}
        </div>
      </div>
    </section>

    <!-- 06 HARGA / INVESTMENT -->
    <section class="dark grid-bg-d" id="harga">
      <div class="wrap">
        <div class="inv-head rv">
          <div class="idx dk">06 / Investment</div>
          <h2 class="sec-t">Investasi Program</h2>
          <p class="sec-p-sub">Satu harga transparan untuk seluruh rangkaian studi lapangan 5 hari 2 negara, mencakup perizinan, akomodasi, hingga pendampingan resmi.</p>
        </div>
        <div class="inv-grid rv">
          <div class="inv-info">
            <div class="inv-highlights">
              <div class="ih-item">
                <span class="ih-icon">✦</span>
                <div>
                  <b>Fasilitas Terjamin</b>
                  <p>Hotel 4 malam, bus VIP, konsumsi halal, perizinan 4 institusi, serta pendampingan langsung CEO Jagatrip.</p>
                </div>
              </div>
              <div class="ih-item">
                <span class="ih-icon">✦</span>
                <div>
                  <b>Fleksibilitas Uang Muka</b>
                  <p>Uang muka Rp 2.500.000 per peserta dapat dikembalikan penuh (<em>100% refund</em>) hingga 18 September 2026.</p>
                </div>
              </div>
            </div>
            <div class="warn">
              <b>Ketentuan Tambahan:</b>
              <ul>
                <li><b>Kamar:</b> Harga berlaku untuk kamar berdua (twin sharing). Permintaan kamar sendiri dikenakan single supplement.</li>
                <li><b>Paspor:</b> Wajib berlaku minimal 6 bulan. Malaysia &amp; Thailand bebas visa untuk paspor Indonesia.</li>
              </ul>
            </div>
          </div>
          <div class="opts">
            <div class="opt single-opt">
              <div class="lbl">Land Tour Package</div>
              <h3>Paket Land Tour</h3>
              <div class="pr2">Rp 7.500.000</div>
              <div class="sub">Belum termasuk tiket pesawat Jakarta PP. Seluruh fasilitas program di lokasi 100% lengkap.</div>
              <ul>
                {pkgCommon.map((x) => <li>{x}</li>)}
                <li class="no">Tiket pesawat Jakarta PP</li>
                <li class="no">Single supplement kamar</li>
                <li class="no">Kartu kedatangan digital &amp; pengeluaran pribadi</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FORM PENDAFTARAN (dipindah ke atas FAQ sesuai revisi) -->
    <section class="reg" id="daftar">
      <div class="wrap reg-in">
        <div class="rv">
          <div class="idx dk">Final Note / Your Move</div>
          <h2>Berangkat sebagai delegasi.<br />Pulang dengan <em>rencana</em>.</h2>
          <p class="rp">Isi data minat. Tim program mengirimkan susunan acara lengkap, profil institusi, dan tata cara pengamanan kursi.</p>
        </div>
        <div class="fcard rv">
          <div id="formArea">
            <form id="regForm" novalidate>
              <div class="fld" id="f1">
                <label for="nama"><i>01</i> Nama Lengkap</label>
                <input type="text" id="nama" placeholder="Sesuai dokumen resmi" autocomplete="name" />
                <div class="err">Mohon lengkapi nama.</div>
              </div>
              <div class="fld" id="f2">
                <label for="institusi"><i>02</i> Institusi</label>
                <input type="text" id="institusi" placeholder="Nama sekolah atau yayasan" autocomplete="organization" />
                <div class="err">Mohon lengkapi nama institusi.</div>
              </div>
              <div class="fld" id="f3">
                <label for="whatsapp"><i>03</i> Nomor WhatsApp</label>
                <input type="tel" id="whatsapp" placeholder="0812-3456-7890" autocomplete="tel" inputmode="tel" />
                <div class="err">Mohon isi nomor yang benar (diawali 08 / 628).</div>
              </div>
              <button type="submit" class="btn b-o">Kirim Minat</button>
            </form>
            <div class="fnote">↗ Tidak mengikat kewajiban pembayaran. Data hanya digunakan untuk penyelenggaraan program ini.</div>
            <div class="fnote-lock">⚠️ <b>Catatan:</b> Form ini hanya dapat diisi <b>1 kali</b> per perangkat untuk menjaga validitas data calon peserta.</div>
          </div>
          <div class="ok" id="okArea">
            <div class="ic">✓</div>
            <h4>Minat Terkirim</h4>
            <p>Mengalihkan ke WhatsApp Admin…</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ (dipindah ke bawah form sesuai revisi) -->
    <section id="faq" class="faq-sec">
      <div class="wrap faq-wrap">
        <div class="idx rv">08 / Questions</div>
        <h2 class="sec-t rv">Sebelum<br />berangkat.</h2>
        <div class="rv">
          {faqs.map(([q, a]) => <details><summary>{q}</summary><div class="a">{a}</div></details>)}
