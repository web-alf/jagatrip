---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import { chinaEventSchema, chinaProgram as p } from '../data/china';
---
<BaseLayout title={`JAGATRIP #2 — ${p.title}`} description={`Program studi banding pendidikan ke Beijing dan Hangzhou, ${p.date}. Dua expo, kunjungan sekolah, kuota ${p.quota} peserta.`} canonical="https://jagatrip.com/china2" ogType="website" extraSchemas={[chinaEventSchema]} gtmId="GTM-NX2FVX9X" gtmId2="GTM-NR8XFKP9">
  <header class="nav">
    <a href="/" aria-label="JAGATRIP"><img src="/images/logo-horizontal.webp" width="2188" height="460" alt="JAGATRIP Mitra Edukasi"></a>
    <a class="nav-cta" href="#form">Daftar minat</a>
  </header>

  <main id="main">
    <section class="hero" data-reveal="hero">
      <div class="hero-copy">
        <p class="kicker"><span></span> JAGATRIP #2 · EDUCATION MISSION</p>
        <h1>Belajar dari <em>kelas dunia,</em> bukan sekadar melihatnya.</h1>
        <p class="hero-lead">Tujuh hari di Beijing dan Hangzhou. Masuk ke dua expo internasional, berdialog di sekolah, pulang membawa jaringan serta perspektif baru.</p>
        <div class="actions"><a class="button primary" href="#form">Ajukan pendaftaran minat</a><a class="button secondary" href="#program">Lihat program <span>↓</span></a></div>
        <p class="micro">Tidak mengikat pembayaran · Hubungi admin untuk info kuota</p>
      </div>
      <aside class="hero-flyer" aria-label="Flyer JAGATRIP #2 China">
        <a class="flyer-link" href="/images/china/flyer-jt-china-2026.webp" target="_blank" rel="noopener">
          <img src="/images/china/flyer-jt-china-2026.webp" width="1254" height="1254" alt="Flyer JAGATRIP #2 China — Beijing & Hangzhou Education Mission" loading="eager" />
        </a>
      </aside>
    </section>

    <section class="proof" aria-label="Fakta program" data-reveal="section">{p.facts.map(([number,label]) => <div><strong>{number}</strong><span>{label}</span></div>)}</section>

    <section class="section intro" id="program" data-reveal="section">
      <div class="section-head"><p class="kicker dark"><span></span> MENGAPA PROGRAM INI</p><h2>Akses yang tidak selesai di pintu pameran.</h2><p>Program disusun untuk pemimpin pendidikan yang ingin melihat kebijakan, teknologi, dan praktik langsung dalam satu perjalanan.</p></div>
      <div class="reasons">{p.differentiators.map(([title,body],i) => <article><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
    </section>

    <section class="section journey" data-reveal="section">
      <div class="section-head light"><p class="kicker"><span></span> RUTE MISI</p><h2>Dua kota. Dua sudut pandang.</h2></div>
      <div class="city-grid" data-reveal-group>{p.cities.map((city,i) => <article class:list={{ city:true, hangzhou:i===1 }}><div class="city-meta"><span>{city.code}</span><small>{city.date}</small></div><p class="cn" aria-hidden="true">{city.cn}</p><h3>{city.name}</h3><p class="city-note">{city.note}</p><ul>{city.items.map(item => <li>{item}</li>)}</ul></article>)}</div>
      <div class="train"><span>BEIJING</span><i></i><b>KERETA CEPAT · ±4,5 JAM</b><i></i><span>HANGZHOU</span></div>
    </section>

    <section class="section outcomes" data-reveal="section">
      <div class="section-head"><p class="kicker dark"><span></span> YANG DIBAWA PULANG</p><h2>Fasilitas terukur. Dampak yang bertumbuh.</h2></div>
      <div class="outcome-grid" data-reveal-group><article><header><span>A</span><div><small>FASILITAS</small><h3>Yang Anda terima</h3></div></header><ul>{p.physicalBenefits.map(x => <li>{x}</li>)}</ul></article><article class="impact"><header><span>B</span><div><small>PROFESIONAL</small><h3>Yang Anda bawa</h3></div></header><ul>{p.professionalBenefits.map(x => <li>{x}</li>)}</ul></article></div>
    </section>

    <section class="section packages" data-reveal="section">
      <div class="section-head light"><p class="kicker"><span></span> OPSI KEBERANGKATAN</p><h2>Pilih cara berangkatnya. Pengalamannya tetap utuh.</h2></div>
      <div class="package-grid" data-reveal-group>{p.packages.map((pkg,i) => <article><span>{i===0?'LAND TOUR':'ALL-IN'}</span><h3>{pkg.name}</h3><p class="price">{pkg.price}</p><p>{pkg.tagline}</p><ul class="facilities">{pkg.facilities.map(([label,ok]) => <li class={ok?'ok':'no'}>{ok?'✓':'✕'} {label}</li>)}</ul><a href="#form">Minta rincian biaya →</a></article>)}</div>
      <p class="visa-note">⚠ {p.visaNote}</p>
    </section>

    <section class="section faq" data-reveal="section"><div class="section-head"><p class="kicker dark"><span></span> FAQ</p><h2>Sebelum Anda berangkat.</h2></div><div class="faq-list">{p.faqs.map(([q,a]) => <details><summary>{q}<span></span></summary><p>{a}</p></details>)}</div></section>

    <section class="form-section" id="form" data-reveal="section">
      <div class="form-copy"><p class="kicker"><span></span> PENDAFTARAN MINAT</p><h2>Satu langkah menuju ruang kelas berikutnya.</h2><p>Isi data singkat. Setelah dikirim, WhatsApp terbuka dengan pesan yang sudah disiapkan untuk admin.</p></div>
      <form class="lead-form" data-china-form><label>Nama lengkap<input name="nama" required minlength="3" autocomplete="name" placeholder="Nama lengkap Anda"></label><label>Asal lembaga / domisili<input name="asal" required minlength="2" autocomplete="organization" placeholder="Lembaga atau kota"></label><label>Nomor WhatsApp<input name="whatsapp" type="tel" required pattern="[0-9+() -]{8,20}" inputmode="tel" autocomplete="tel" placeholder="0812 3456 7890"></label><button>Kirim & buka WhatsApp</button><small>Data Anda hanya diteruskan melalui pesan WhatsApp yang Anda kirim.</small></form>
    </section>
  </main>
  <Footer />

  <script>
    import { getUtm } from '../lib/utm';
    import { initFormGuard, lockForm, isPhoneSubmitted } from '../lib/form-guard';
    import { parseIndonesianPhone } from '../lib/phone-formatter';
    const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwrwCUYnuIUCflczefMlYAHdCnOD-5PMqVEL94QTPWy6Hkds6SiOQLfyo7PZpVoqtjiZg/exec';
    const cform=document.querySelector<HTMLFormElement>('[data-china-form]');
    if(cform){initFormGuard(cform,'china2-form','✓ Data Anda sudah terkirim. Tim JAGATRIP akan menghubungi Anda.');
    cform.addEventListener('submit', event => {
      event.preventDefault(); const form=event.currentTarget as HTMLFormElement; if(!form.reportValidity()) return;
      const data=new FormData(form), nama=String(data.get('nama')).trim(), asal=String(data.get('asal')).trim(), rawWa=String(data.get('whatsapp')).trim();
      const parsedPhone = parseIndonesianPhone(rawWa);
      const wa = parsedPhone.e164 || rawWa;
      const isDuplicate = isPhoneSubmitted('china2-form', wa);
      fetch(APPS_SCRIPT_URL, {
        method: 'POST', mode: 'no-cors',
        body: JSON.stringify({ _sheet: 'China2', nama, asal, wa, ...getUtm(), timestamp: new Date().toISOString(), source: window.location.href }),
      }).catch(() => {});
      if (typeof (window as any).fbq === 'function') (window as any).fbq('track', 'Lead', { content_name: 'China2' });
      const message=isDuplicate
        ? `Halo Admin, saya ${nama} dari ${asal} sebelumnya sudah mendaftar Jagatrip ke China dengan nomor ini, ingin konfirmasi kelanjutan pendaftaran.`
        : `Halo Admin, saya ${nama} dari ${asal} tertarik ikut Jagatrip ke China dan sudah mengisi form. Nomor WhatsApp saya ${parsedPhone.display || wa}. Bagaimana selanjutnya?`;
      const cs=['628139190363','6281128506576'], nomor=cs[Math.floor(Math.random()*cs.length)];
      lockForm(form,'china2-form', isDuplicate ? '✓ Anda sudah terdaftar sebelumnya. Mengalihkan ke WhatsApp...' : '✓ Data Anda sudah terkirim. Mengalihkan ke WhatsApp...', wa);
      setTimeout(() => { location.href=`https://wa.me/${nomor}?text=${encodeURIComponent(message)}`; }, 300);
    })}
  </script>
</BaseLayout>

<style>
  :global(body){background:#faf7f2;color:#211b17;font-family:Outfit,ui-sans-serif,sans-serif} :global(*){box-sizing:border-box} .nav{height:72px;padding:0 max(24px,calc((100vw - 1160px)/2));display:flex;align-items:center;justify-content:space-between;background:rgba(250,247,242,.92);backdrop-filter:blur(14px);position:sticky;top:0;z-index:20;border-bottom:2px solid #FF6B36}.nav img{display:block;width:170px;height:auto}.nav-cta,.button,.lead-form button{background:#ff5b09;color:white;border:0;border-radius:2px;text-decoration:none;font-weight:800;padding:13px 20px;transition:.2s}.nav-cta:hover,.primary:hover,.lead-form button:hover{background:#b94717;transform:translateY(-2px)}
  .hero{min-height:auto;max-width:1160px;margin:auto;padding:36px 24px 40px;display:grid;grid-template-columns:1.12fr .88fr;gap:48px;align-items:center}.kicker{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:800;letter-spacing:.16em;color:#fff;margin:0 0 22px}.kicker span{width:28px;height:2px;background:#c99a35}.kicker.dark{color:#8e3b1a}.hero h1{font-size:clamp(48px,6vw,76px);line-height:.98;letter-spacing:-.055em;margin:0;max-width:760px}.hero h1 em{font-family:Georgia,serif;font-weight:400;color:#b4232d}.hero-lead{font-size:19px;line-height:1.65;color:#665d56;max-width:670px;margin:28px 0}.actions{display:flex;gap:12px;align-items:center}.button{display:inline-flex;align-items:center;justify-content:center;min-height:50px}.secondary{background:transparent;color:#211b17;border:1px solid #bdb4aa}.secondary:hover{border-color:#ff5b09;color:#ff5b09}.secondary span{margin-left:20px}.micro{font-size:13px;color:#7f746b;margin:14px 0 0}
  .hero-flyer{position:relative;justify-self:center;width:100%;max-width:440px}.flyer-link{display:block;position:relative;box-shadow:18px 18px 0 #ff5b09;transition:transform .35s cubic-bezier(.2,.8,.25,1),box-shadow .35s ease}.flyer-link img{display:block;width:100%;height:auto;border:1px solid #ded7ce}.flyer-link:hover{transform:translate(-4px,-4px);box-shadow:22px 22px 0 #211b17}
  .live{display:inline-block;width:7px;height:7px;border-radius:50%;background:#ff5b09}
  .proof{background:#ff5b09;color:white;display:grid;grid-template-columns:repeat(4,1fr);padding:0 max(24px,calc((100vw - 1160px)/2))}.proof div{padding:28px 24px;border-right:1px solid rgba(255,255,255,.25);display:flex;align-items:baseline;gap:12px}.proof strong{font:700 40px Georgia,serif}.proof span{font-size:13px}
  .facilities{list-style:none;padding:18px 0 0;margin:0;border-top:1px solid #5c5048}.facilities li{padding:8px 0;border-bottom:1px solid #4a4039;font-size:15px;display:flex;gap:10px}.facilities li.ok{color:#fff}.facilities li.no{color:rgba(255,255,255,.5);text-decoration:line-through;text-decoration-color:rgba(255,255,255,.35)}.visa-note{margin:24px 0 0;font-size:14px;line-height:1.6;color:#fff;background:rgba(0,0,0,.18);padding:16px 18px;border-left:3px solid #c99a35}.section{padding:34px max(24px,calc((100vw - 1160px)/2))}.section-head{display:grid;grid-template-columns:1fr 1.4fr;gap:24px;margin-bottom:48px}.section-head .kicker{grid-column:1/-1;margin-bottom:0}.section-head h2{font-size:clamp(38px,5vw,58px);line-height:1;letter-spacing:-.045em;margin:0}.section-head>p:last-child{font-size:17px;line-height:1.7;color:#71675f;margin:0;max-width:540px}.reasons{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #cfc6bc}.reasons article{padding:28px 28px 10px 0;border-right:1px solid #cfc6bc}.reasons article+article{padding-left:28px}.reasons span{color:#b4232d;font-weight:800}.reasons h3{font-size:22px;margin:30px 0 12px}.reasons p{color:#71675f;line-height:1.65}
  .journey,.packages{background:#211b17;color:white}.section-head.light h2{color:white}.city-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#4a4039}.city{background:#2a231f;padding:40px;position:relative;overflow:hidden}.city.hangzhou{background:#302520}.city-meta{display:flex;justify-content:space-between;color:#d1c6bc}.city-meta span{color:#ff5b09;font-weight:900;letter-spacing:.15em}.city .cn{position:absolute;right:22px;top:-55px;font:160px Georgia,serif;color:rgba(255,255,255,.035)}.city h3{font:56px Georgia,serif;margin:36px 0 4px}.city-note{color:#c99a35}.city ul{list-style:none;padding:20px 0 0;margin:20px 0 0;border-top:1px solid #544940}.city li{padding:8px 0;color:#d7cec7}.city li::before{content:'—';color:#ff5b09;margin-right:12px}.train{display:flex;align-items:center;gap:18px;margin-top:30px;font-size:11px;letter-spacing:.12em;color:#bdb2a9}.train i{height:1px;background:#685c53;flex:1}.train b{color:#c99a35;font-size:10px}
  .outcome-grid,.package-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.outcome-grid article{background:white;border:1px solid #dcd4ca;padding:34px}.outcome-grid header{display:flex;gap:16px;align-items:center;border-bottom:1px solid #ddd4ca;padding-bottom:22px}.outcome-grid header>span{display:grid;place-items:center;width:46px;height:46px;background:#ff5b09;color:white;font-weight:900}.outcome-grid small{letter-spacing:.15em;color:#9a4b29}.outcome-grid h3{margin:3px 0;font-size:24px}.outcome-grid ul{columns:2;list-style:none;padding:15px 0 0}.outcome-grid li{break-inside:avoid;padding:9px 0;font-size:14px}.outcome-grid li::before{content:'✓';color:#ff5b09;margin-right:8px}.outcome-grid .impact{background:#fff9f4}.package-grid article{border:1px solid #5c5048;padding:34px}.package-grid article>span{font-size:10px;letter-spacing:.16em;color:#c99a35}.package-grid h3{font:22px Georgia,serif;margin-bottom:6px}.package-grid .price{color:#ff5b09;font:700 22px Georgia,serif;line-height:1;min-height:auto;margin-bottom:12px;letter-spacing:-.02em}.package-grid p:not(.price){color:#c9beb5;line-height:1.65;min-height:74px}.package-grid a{color:white;text-decoration:none;font-weight:800}.package-grid a:hover{color:#ff5b09}
  .faq-list{max-width:820px;margin-left:auto}.faq details{border-top:1px solid #cfc6bc}.faq details:last-child{border-bottom:1px solid #cfc6bc}.faq summary{padding:22px 0;list-style:none;cursor:pointer;font-size:18px;font-weight:700;display:flex;justify-content:space-between}.faq summary::-webkit-details-marker{display:none}.faq summary span::after{content:'+';font-size:24px;color:#ff5b09}.faq details[open] summary span::after{content:'−'}.faq details p{margin:0;padding:0 45px 22px 0;color:#71675f;line-height:1.65}
  .form-section{background:#ff5b09;color:white;padding:36px max(24px,calc((100vw - 1160px)/2));display:grid;grid-template-columns:.85fr 1.15fr;gap:44px;align-items:center}.form-copy h2{font-size:clamp(40px,5vw,62px);line-height:1;letter-spacing:-.045em;margin:0}.form-copy>p:not(.kicker){line-height:1.65;max-width:480px}.quota{display:flex;align-items:center;gap:12px;border-top:1px solid rgba(255,255,255,.35);padding-top:20px;margin-top:30px}.quota strong{font:72px Georgia,serif}.quota span{font-size:13px;text-transform:uppercase;letter-spacing:.1em}.lead-form{background:#fff;color:#211b17;padding:36px;box-shadow:14px 14px 0 #211b17}.lead-form label{display:block;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:18px}.lead-form input{display:block;width:100%;padding:13px 0;border:0;border-bottom:1px solid #bfb5ab;background:white;font:16px Outfit,sans-serif;border-radius:0}.lead-form input:focus{outline:0;border-color:#ff5b09;box-shadow:0 2px #ff5b09}.lead-form button{width:100%;font:800 15px Outfit,sans-serif;cursor:pointer;margin-top:8px;min-height:52px}.lead-form small{display:block;text-align:center;color:#857a71;margin-top:14px}
  :where(a,button,summary,input):focus-visible{outline:3px solid #c99a35;outline-offset:4px}@media(max-width:800px){.nav{padding-inline:18px}.nav img{width:142px}.nav-cta{font-size:12px;padding:12px 14px;min-height:44px;display:inline-flex;align-items:center}.hero{grid-template-columns:1fr;padding:40px 20px 52px;gap:38px}.hero h1{font-size:50px}.kicker{font-size:13px}.hero-lead{font-size:17px}.hero-flyer{max-width:300px;order:2}.hero-flyer dt{font-size:12px}.hero-flyer dd{font-size:16px}.button{min-height:52px}.proof{grid-template-columns:1fr 1fr;padding:0}.proof div:nth-child(2){border-right:0}.proof div{padding:20px}.proof strong{font-size:32px}.proof span{font-size:14px}.section{padding:40px 20px}.section-head{grid-template-columns:1fr}.section-head h2{font-size:42px}.section-head>p:last-child{font-size:16px}.reasons,.city-grid,.outcome-grid,.package-grid,.form-section{grid-template-columns:1fr}.reasons article,.reasons article+article{padding:26px 0;border-right:0;border-bottom:1px solid #cfc6bc}.reasons h3{font-size:20px}.reasons p{font-size:15px}.outcome-grid article{padding:26px}.outcome-grid small{font-size:13px}.outcome-grid h3{font-size:22px}.outcome-grid li{font-size:15px}.outcome-grid ul{columns:1}.train span{display:none}.package-grid article{padding:28px}.package-grid article>span{font-size:13px}.package-grid h3{font-size:22px}.package-grid p{font-size:15px}.package-grid a{display:inline-flex;align-items:center;min-height:44px}.faq summary{font-size:18px;min-height:44px;padding:20px 0;align-items:center}.faq details p{font-size:15px}.form-section{padding:40px 20px;gap:35px}.form-copy h2{font-size:40px}.form-copy>p:not(.kicker){font-size:16px}.lead-form{padding:26px;box-shadow:8px 8px 0 #211b17}.lead-form label{font-size:13px;margin-bottom:20px}.lead-form input{font-size:18px;padding:14px 0}.lead-form button{min-height:52px;font-size:15px}.lead-form small{font-size:13px}.actions{align-items:stretch;flex-direction:column}.secondary{border:0;padding-left:0;justify-content:flex-start}.city{padding:28px}.city h3{font-size:44px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
