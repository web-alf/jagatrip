<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Support style-hover and style-focus attributes exactly as designed in Dropcanvas
    document.querySelectorAll('[style-hover]').forEach(el => {
      const orig = el.getAttribute('style') || '';
      const hover = el.getAttribute('style-hover') || '';
      el.addEventListener('mouseenter', () => {
        el.setAttribute('style', orig + ';' + hover);
      });
      el.addEventListener('mouseleave', () => {
        el.setAttribute('style', orig);
      });
    });

    document.querySelectorAll('[style-focus]').forEach(el => {
      const orig = el.getAttribute('style') || '';
      const focus = el.getAttribute('style-focus') || '';
      el.addEventListener('focus', () => {
        el.setAttribute('style', orig + ';' + focus);
      });
      el.addEventListener('blur', () => {
        el.setAttribute('style', orig);
      });
    });

    // 1b. Mobile Navigation Drawer Toggle
    const menuToggle = document.getElementById('jt8-menu-toggle');
    const mobileDrawer = document.getElementById('jt8-mobile-drawer');
    const iconMenu = document.getElementById('jt8-icon-menu');
    const iconClose = document.getElementById('jt8-icon-close');
    let drawerOpen = false;

    function setDrawer(open) {
      drawerOpen = open;
      if (mobileDrawer) mobileDrawer.style.display = open ? 'block' : 'none';
      if (iconMenu) iconMenu.style.display = open ? 'none' : 'block';
      if (iconClose) iconClose.style.display = open ? 'block' : 'none';
    }

    if (menuToggle) {
      menuToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setDrawer(!drawerOpen);
      });
    }

    document.querySelectorAll('.jt8-drawer-link').forEach(link => {
      link.addEventListener('click', () => setDrawer(false));
    });

    document.addEventListener('click', (e) => {
      if (drawerOpen && mobileDrawer && !mobileDrawer.contains(e.target) && !menuToggle?.contains(e.target)) {
        setDrawer(false);
      }
    });

    // 2. Smooth Scroll to Form
    const formEl = document.getElementById('form');
    function goForm() {
      if (formEl) {
        const top = formEl.getBoundingClientRect().top + window.scrollY - 72;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    }

    document.querySelectorAll('.btn-go-form').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        goForm();
      });
    });

    // 3. Package Selection (Regular vs Premium)
    let selectedPkg = "Regular";
    const regBtn = document.getElementById('form-pkg-regular');
    const premBtn = document.getElementById('form-pkg-premium');

    function updatePkgUi() {
      if (selectedPkg === "Regular") {
        if (regBtn) {
          regBtn.style.background = "#FFF7ED";
          regBtn.style.border = "1.5px solid #F97316";
        }
        if (premBtn) {
          premBtn.style.background = "#FFFFFF";
          premBtn.style.border = "1.5px solid #E2E8F0";
        }
      } else {
        if (premBtn) {
          premBtn.style.background = "#FFF7ED";
          premBtn.style.border = "1.5px solid #F97316";
        }
        if (regBtn) {
          regBtn.style.background = "#FFFFFF";
          regBtn.style.border = "1.5px solid #E2E8F0";
        }
      }
    }

    function pick(pkg) {
      selectedPkg = pkg;
      updatePkgUi();
      goForm();
    }

    const btnPickReg = document.getElementById('btn-pick-regular');
    const btnPickPrem = document.getElementById('btn-pick-premium');
    if (btnPickReg) btnPickReg.addEventListener('click', () => pick('Regular'));
    if (btnPickPrem) btnPickPrem.addEventListener('click', () => pick('Premium'));

    if (regBtn) regBtn.addEventListener('click', () => { selectedPkg = 'Regular'; updatePkgUi(); });
    if (premBtn) premBtn.addEventListener('click', () => { selectedPkg = 'Premium'; updatePkgUi(); });

    // 4. FAQ Accordion logic
    const faqItems = document.querySelectorAll('.faq-item');
    let openFaqIdx = -1;

    faqItems.forEach((item, idx) => {
      const btn = item.querySelector('.faq-btn');
      const sign = item.querySelector('.faq-icon-sign');
      const panel = item.querySelector('.faq-panel');

      if (btn && sign && panel) {
        btn.addEventListener('click', () => {
          if (openFaqIdx === idx) {
            // Close currently open
            openFaqIdx = -1;
            panel.style.display = 'none';
            sign.textContent = '+';
            sign.style.background = '#FFF7ED';
            sign.style.color = '#C2410C';
          } else {
            // Close all
            faqItems.forEach(other => {
              const otherSign = other.querySelector('.faq-icon-sign');
              const otherPanel = other.querySelector('.faq-panel');
              if (otherSign) {
                otherSign.textContent = '+';
                otherSign.style.background = '#FFF7ED';
                otherSign.style.color = '#C2410C';
              }
              if (otherPanel) otherPanel.style.display = 'none';
            });

            // Open clicked
            openFaqIdx = idx;
            panel.style.display = 'block';
            sign.textContent = '–';
            sign.style.background = '#F97316';
            sign.style.color = '#FFFFFF';
          }
        });
      }
    });

    // 5. Form Submission & WhatsApp Redirect
    function formatPhone(raw) {
      if (!raw) return { sheetWa: '', waNumber: '', digits: '' };
      let digits = raw.toString().replace(/[^0-9]/g, '');
      let e164 = '';
      if (digits.startsWith('0')) {
        e164 = '62' + digits.slice(1);
      } else if (digits.startsWith('6208')) {
        e164 = '62' + digits.slice(3);
      } else if (digits.startsWith('62')) {
        e164 = digits;
      } else if (digits.startsWith('8')) {
        e164 = '62' + digits;
      } else {
        e164 = '62' + digits;
      }
      const localPhone = '0' + e164.slice(2);
      const sheetWa = "'" + localPhone;
      return { sheetWa, waNumber: e164, digits: localPhone };
    }

    const regForm = document.getElementById('landing-reg-form');
    const inputNama = document.getElementById('input-nama');
    const inputLembaga = document.getElementById('input-lembaga');
    const inputWa = document.getElementById('input-wa');
    const submitBtn = document.getElementById('form-submit-btn');

    if (inputWa) {
      inputWa.addEventListener('input', (e) => {
        const cleaned = e.target.value.replace(/[^0-9+\-\s]/g, '');
        if (cleaned !== e.target.value) {
          e.target.value = cleaned;
        }
      });
    }

    if (regForm) {
      regForm.addEventListener('submit', (e) => {
        e.preventDefault();

        const nama = inputNama ? inputNama.value.trim() : '';
        const lembaga = inputLembaga ? inputLembaga.value.trim() : '';
        const rawWa = inputWa ? inputWa.value.trim() : '';
        const phone = formatPhone(rawWa);

        if (!nama || !lembaga || !rawWa) {
          window.alert('Mohon lengkapi Nama, Asal Lembaga, dan Nomor WhatsApp.');
          return;
        }

        if (phone.digits.length < 9 || phone.digits.length > 15) {
          window.alert('Format nomor WhatsApp tidak valid (contoh: 081234567890).');
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Mengarahkan ke WhatsApp...';
        }

        // Send to Apps Script Webhook
        const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwrwCUYnuIUCflczefMlYAHdCnOD-5PMqVEL94QTPWy6Hkds6SiOQLfyo7PZpVoqtjiZg/exec';
        try {
          const params = new URLSearchParams(window.location.search);
          fetch(APPS_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            keepalive: true,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              _sheet: 'LP_Jagatalk8',
              nama: nama,
              institusi: lembaga,
              instansi: lembaga,
              asal_lembaga: lembaga,
              wa: phone.sheetWa,
              paket: selectedPkg,
              source: 'JAGATALK #8 (' + selectedPkg + ') Landing Page (/jagatalk8)',
              timestamp: new Date().toISOString(),
              utm_source: params.get('utm_source') || '',
              utm_medium: params.get('utm_medium') || '',
              utm_campaign: params.get('utm_campaign') || '',
              utm_term: params.get('utm_term') || '',
              utm_content: params.get('utm_content') || '',
              gclid: params.get('gclid') || '',
              fbclid: params.get('fbclid') || ''
            })
          }).catch((err) => console.error('Webhook error:', err));
        } catch (err) {
          console.error('Fetch error:', err);
        }

        // Meta Pixel & GTM Events
        if (window.fbq) {
          try { window.fbq('track', 'Lead'); } catch (err) { console.error('FB Pixel error:', err); }
        }
        if (window.dataLayer) {
          try {
            window.dataLayer.push({
              event: 'lead_form_submit',
              form_name: 'jagatalk8',
              user_name: nama,
              user_instansi: lembaga,
              user_package: selectedPkg
            });
          } catch (err) {
            console.error('GTM error:', err);
          }
        }

        // WhatsApp redirect (matches Jagatalk 8 Landing.dc.html exactly)
        const text = "Halo Admin Jagatrip, saya ingin mendaftar JAGATALK #8.%0ANama: " + encodeURIComponent(nama) + "%0AAsal Lembaga/Domisili: " + encodeURIComponent(lembaga) + "%0ANo. WhatsApp: " + encodeURIComponent(phone.digits) + "%0APaket: " + selectedPkg;
        const waUrl = "https://wa.me/6281128506576?text=" + text;

        setTimeout(() => {
          window.location.href = waUrl;
        }, 300);
      });
    }
  });
</script>

