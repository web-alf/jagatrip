---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "JAGATALK #8 — Roadmap Sekolah Membangun Program Internasional";
const pageDesc = "Sesi eksklusif untuk kepala sekolah, manajemen, founder & yayasan yang siap berhenti bertanya “mulai dari mana” — dan mulai bergerak dengan roadmap yang jelas dan praktis.";

const FAQS = [
  {
    q: "Saya bukan kepala sekolah — apakah tetap boleh ikut?",
    a: "Boleh. Sesi ini terbuka untuk siapapun yang punya peran strategis di sekolah swasta: founder, direktur, ketua yayasan, wakil kepala sekolah, atau guru senior yang sedang dipersiapkan untuk peran leadership."
  },
  {
    q: "Apa bedanya paket Regular dan Premium?",
    a: "Paket Regular memberikan akses penuh ke webinar, semua materi, rekaman, worksheet, dan sertifikat. Paket Premium menambahkan Prioritas Undangan ke Exclusive Meet-Up dengan PIC Kampus Mitra Jagatrip di Malaysia — sesi terpisah yang dijadwalkan beberapa minggu setelah webinar utama."
  },
  {
    q: "Apakah Meet-Up dengan kampus Malaysia langsung menghasilkan MoU?",
    a: "Tidak — Meet-Up adalah sesi awareness & introduction. Anda mendapatkan akses bertanya langsung ke PIC kampus tentang program & kriteria kolaborasi. Kalau tertarik melanjutkan ke partnership formal, tahap berikutnya (due diligence & MoU) dapat difasilitasi Jagatrip sesuai kebutuhan."
  },
  {
    q: "Kapan Exclusive Meet-Up dilaksanakan?",
    a: "Meet-Up dijadwalkan beberapa minggu setelah Jagatalk #8. Tanggal final akan diinformasikan maksimal 7 hari setelah webinar utama. Peserta Premium mendapat notifikasi via email & WhatsApp."
  },
  {
    q: "Bagaimana kalau saya berhalangan hadir di hari-H?",
    a: "Tidak masalah. Rekaman lengkap akan dikirim ke email Anda maksimal 3 hari setelah acara. Anda tetap bisa menonton di waktu senggang."
  },
  {
    q: "Bisa reimburse ke sekolah atau yayasan?",
    a: "Ya. E-sertifikat resmi Jagatrip yang Anda terima bisa dijadikan bukti untuk reimburse biaya ke institusi Anda (sesuai policy masing-masing)."
  },
  {
    q: "Bagaimana metode pembayaran?",
    a: "Setelah Anda submit form, admin kami akan menghubungi Anda via WhatsApp untuk konfirmasi paket & instruksi pembayaran. Kami menerima transfer bank, e-wallet, dan virtual account."
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical="https://jagatrip.com/jagatalk8"
  ogImage="/images/jagatalk/flyer-jw8-v3.avif"
  ogType="website"
>
  <!-- Google Fonts: Caveat, Plus Jakarta Sans, Montserrat -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Montserrat:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,600&display=swap" rel="stylesheet" />

  <div style="width:100%; overflow-x:hidden; background:#FFFFFF; color:#0B2341; font-family:'Plus Jakarta Sans', system-ui, sans-serif;">

    <!-- ============ HEADER ============ -->
    <header style="position:sticky; top:0; z-index:60; background:#FFFFFF; border-bottom:1px solid #E2E8F0;">
      <div class="jt8-header-container" style="max-width:1240px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:20px;">
        <!-- Logo -->
        <a href="#beranda" style="display:flex; align-items:center; gap:10px; white-space:nowrap; text-decoration:none; flex-shrink:0;">
          <img src="/images/jagatalk/logo-jagatalk.png" alt="JAGATALK #8" class="jt8-header-logo" style="height:44px; width:auto; display:block;" />
        </a>

        <!-- Desktop Nav (screens >= 768px) -->
        <nav class="jt8-desktop-nav hidden md:flex" style="margin-left:auto; align-items:center; gap:28px;">
          <a href="#beranda" style="font-size:14.5px; font-weight:600; color:#475569;" style-hover="color:#0B2341;">Beranda</a>
          <a href="#tentang" style="font-size:14.5px; font-weight:600; color:#475569;" style-hover="color:#0B2341;">Tentang</a>
          <a href="#materi" style="font-size:14.5px; font-weight:600; color:#475569;" style-hover="color:#0B2341;">Materi</a>
          <a href="#harga" style="font-size:14.5px; font-weight:600; color:#475569;" style-hover="color:#0B2341;">Harga</a>
          <button type="button" class="btn-go-form" style="background:#F97316; color:#FFFFFF; border:none; border-radius:10px; padding:12px 20px; min-height:44px; font-size:14.5px; font-weight:700; cursor:pointer; box-shadow:0 1px 2px rgba(11,35,65,0.12);" style-hover="background:#EA6A0B;">Daftar Sekarang</button>
        </nav>

        <!-- Mobile Controls (screens < 768px) -->
        <div class="jt8-mobile-controls flex md:hidden" style="align-items:center; gap:10px;">
          <button type="button" class="btn-go-form jt8-mobile-cta" style="background:#F97316; color:#FFFFFF; border:none; border-radius:8px; padding:9px 15px; min-height:38px; font-size:13.5px; font-weight:700; cursor:pointer; white-space:nowrap; box-shadow:0 1px 2px rgba(11,35,65,0.12);" style-hover="background:#EA6A0B;">Daftar</button>
          <button type="button" id="jt8-menu-toggle" aria-label="Toggle Menu" style="background:#F8FAFC; border:1px solid #CBD5E1; border-radius:8px; width:38px; height:38px; display:flex; align-items:center; justify-content:center; cursor:pointer; color:#0B2341; padding:0;">
            <svg id="jt8-icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            <svg id="jt8-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" style="display:none;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu Drawer -->
      <div id="jt8-mobile-drawer" class="jt8-mobile-drawer" style="display:none; background:#FFFFFF; border-top:1px solid #F1F5F9; box-shadow:0 14px 30px -10px rgba(11,35,65,0.18); padding:16px 20px 24px;">
        <nav style="display:flex; flex-direction:column; gap:6px;">
          <a href="#beranda" class="jt8-drawer-link" style="display:block; font-size:15px; font-weight:700; color:#0B2341; padding:12px 8px; border-bottom:1px solid #F1F5F9; text-decoration:none;">Beranda</a>
          <a href="#tentang" class="jt8-drawer-link" style="display:block; font-size:15px; font-weight:700; color:#0B2341; padding:12px 8px; border-bottom:1px solid #F1F5F9; text-decoration:none;">Tentang</a>
          <a href="#materi" class="jt8-drawer-link" style="display:block; font-size:15px; font-weight:700; color:#0B2341; padding:12px 8px; border-bottom:1px solid #F1F5F9; text-decoration:none;">Materi</a>
          <a href="#harga" class="jt8-drawer-link" style="display:block; font-size:15px; font-weight:700; color:#0B2341; padding:12px 8px; border-bottom:1px solid #F1F5F9; text-decoration:none;">Harga</a>
          <button type="button" class="btn-go-form jt8-drawer-link" style="margin-top:12px; width:100%; background:#F97316; color:#FFFFFF; border:none; border-radius:10px; padding:14px; min-height:48px; font-size:15px; font-weight:700; cursor:pointer; text-align:center;">Daftar Sekarang</button>
        </nav>
      </div>
    </header>

    <!-- ============ HERO SECTION ============ -->
    <section id="beranda" style="position:relative; overflow:hidden; background:linear-gradient(160deg,#FFFFFF 0%,#FFFDF9 45%,#FFF3E4 100%); border-bottom:1px solid #F1E9DD;">
      <div style="position:absolute; inset:0; background-image:radial-gradient(#F9731622 1.1px, transparent 1.1px); background-size:26px 26px; opacity:0.55; pointer-events:none;"></div>
      <div style="position:absolute; right:-140px; top:-120px; width:520px; height:520px; border-radius:50%; background:radial-gradient(circle at 35% 35%, #FFE3C4 0%, #FFF3E4 60%, rgba(255,243,228,0) 72%); pointer-events:none;"></div>
      <div class="jt8-section-pad" style="position:relative; max-width:1240px; margin:0 auto; padding:clamp(36px,4.5vw,64px) 24px clamp(40px,4.5vw,60px); display:flex; flex-wrap:wrap; gap:clamp(32px,5vw,72px); align-items:center;">

        <div style="flex:1 1 440px; min-width:0;">
          <div style="display:inline-flex; align-items:center; gap:10px; border:1px solid #FED7AA; background:#FFF7ED; color:#C2410C; border-radius:999px; padding:8px 14px; font-size:12.5px; font-weight:700; letter-spacing:0.04em;">
            <span style="width:6px; height:6px; border-radius:50%; background:#F97316; display:inline-block;"></span>
            JAGATALK #8 | Webinar Eksklusif Manajemen Sekolah
          </div>

          <h1 class="jt8-hero-h1" style="margin:22px 0 0; font-size:clamp(22px,5.2vw,56px); line-height:1.15; letter-spacing:-0.03em; font-weight:800; color:#0B2341;">ROADMAP SEKOLAH MEMBANGUN<span style="color:#F97316; display:inline-block;">PROGRAM INTERNASIONAL</span></h1>

          <p class="jt8-hero-sub-text" style="margin: 16px 0 0; font-family: 'Montserrat', sans-serif; font-size: clamp(26px,2.6vw,34px); font-weight: 700; color: #F97316; line-height: 1.1">Dari yang sudah membangunnya 6 kali.</p>

          <p style="margin:14px 0 0; max-width:560px; font-size:16.5px; line-height:1.7; color:#475569; text-wrap:pretty;">Sesi eksklusif untuk kepala sekolah, manajemen, founder &amp; yayasan yang siap berhenti bertanya “mulai dari mana” — dan mulai bergerak dengan roadmap yang jelas dan praktis.</p>

          <div style="margin-top:30px; display:flex; flex-wrap:wrap; align-items:center; gap:16px;">
            <button type="button" class="btn-go-form jt8-btn-mobile-full" style="background:#F97316; color:#FFFFFF; border:none; border-radius:12px; padding:17px 30px; min-height:56px; font-size:16.5px; font-weight:800; letter-spacing:-0.01em; cursor:pointer; box-shadow:0 8px 20px rgba(249,115,22,0.28);" style-hover="background:#EA6A0B; transform:translateY(-2px);">Amankan Kursi Anda</button>
          </div>

          <div class="jt8-meta-container" style="margin-top:26px; padding-top:22px; border-top:1px solid #E9DFD1; display:flex; flex-wrap:wrap; gap:14px 28px;">
            <div style="display:flex; gap:11px; align-items:center;">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="1.8" style="flex:none;"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4M16 3v4M3 10h18"></path></svg>
              <div><div style="font-size:10.5px; font-weight:800; letter-spacing:0.12em; color:#94A3B8;">TANGGAL</div><div style="margin-top:2px; font-size:14.5px; font-weight:700; color:#0B2341;">23 September 2026</div></div>
            </div>
            <div style="display:flex; gap:11px; align-items:center;">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="1.8" style="flex:none;"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
              <div><div style="font-size:10.5px; font-weight:800; letter-spacing:0.12em; color:#94A3B8;">JAM</div><div style="margin-top:2px; font-size:14.5px; font-weight:700; color:#0B2341;">19.30 WIB</div></div>
            </div>
            <div style="display:flex; gap:11px; align-items:center;">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="1.8" style="flex:none;"><rect x="2" y="6" width="14" height="12" rx="2"></rect><path d="M16 11l6-3v8l-6-3z"></path></svg>
              <div><div style="font-size:10.5px; font-weight:800; letter-spacing:0.12em; color:#94A3B8;">PLATFORM</div><div style="margin-top:2px; font-size:14.5px; font-weight:700; color:#0B2341;">Via Zoom Meeting</div></div>
            </div>
          </div>
          
        </div>

        <div style="flex:1 1 420px; min-width:0; display:flex; justify-content:center;">
          <div style="position:relative; width:100%; max-width:500px;">
            <div style="position:relative; border-radius:16px; overflow:hidden; background:#EEF0F6; box-shadow:0 24px 50px -32px rgba(11,35,65,0.45);">
              <img src="/dedi-photo.jpg" alt="Muhammad Dedi Gunawan — Founder Jagatrip &amp; 6 Sekolah IDN" style="display:block; width:100%; aspect-ratio:4/5; object-fit:cover; object-position:50% 12%;">
              <div style="position: absolute; left: 0; top: 0; width: 130px; height: 4px; background: #F97316"></div>
            </div>

            <div style="margin-top:16px; display:flex; flex-wrap:wrap; align-items:center; gap:12px 20px; padding-top:16px; border-top:1px solid #E2E8F0;">
              <div style="min-width:0;">
                <div style="font-size:10.5px; font-weight:800; letter-spacing:0.14em; color:#C2410C;">PEMATERI</div>
                <div style="margin-top:4px; font-size:18px; font-weight:800; letter-spacing:-0.02em; color:#0B2341;">Dedi Gunawan</div>
                <div style="margin-top:2px; font-size:13.5px; font-weight:600; color:#64748B;">Founder Jagatrip &amp; 6 Sekolah IDN</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ============ SECTION TENTANG ============ -->
    <section id="tentang" style="background:#FFF7ED; border-bottom:1px solid #FDE7CE;">
      <div class="jt8-section-pad" style="max-width:1240px; margin:0 auto; padding:clamp(40px,4.5vw,64px) 24px;">
        <div style="max-width:900px;">
          <div style="font-size:12px; font-weight:800; letter-spacing:0.14em; color:#C2410C;"><span class="eyebrow" style="border: 0px solid; margin: 0px 0px 8px; padding: 0px 0px 0px 26px; display: inline-block; color: rgb(232, 93, 31); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; position: relative; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-align: center; background-color: rgb(253, 246, 235);">Untuk Anda yang Merasakan Ini</span></div>
          <h2 style="margin:14px 0 0; font-size:clamp(26px,3.1vw,40px); line-height:1.22; letter-spacing:-0.02em; font-weight:800; color:#0B2341; text-wrap:pretty;">Anda Bingung Membangun Sekolah Memiliki Reputasi dan Kolaborasi Global?</h2>
          <p style="margin:18px 0 0; font-size:16.5px; line-height:1.7; color:#475569;">Kalau Anda mencentang minimal 1 dari 4 ini, Anda harus ikut sesi webinar ini:</p>
        </div>

        <div class="jt8-grid-pain" style="margin-top:40px; display:grid; grid-template-columns:repeat(2, 1fr); gap:0 clamp(28px,4vw,64px);">
          <div style="display:flex; gap:18px; padding:22px 0; border-top:1px solid #F1D9BE;">
            <div style="flex:none; width:30px; height:30px; border-radius:8px; background:#FFFFFF; border:1px solid #FED7AA; display:flex; align-items:center; justify-content:center;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="3"><path d="M4 12.5l5 5L20 6.5"></path></svg></div>
            <p style="margin:0; font-size:15.5px; line-height:1.68; color:#475569;">Yayasan atau owner mulai bertanya <strong style="color:#0B2341;">“kapan sekolah kita bisa naik kelas ke level internasional?”</strong> — dan Anda belum punya jawaban yang meyakinkan.</p>
          </div>
          
          <div style="display:flex; gap:18px; padding:22px 0; border-top:1px solid #F1D9BE;">
            <div style="flex:none; width:30px; height:30px; border-radius:8px; background:#FFFFFF; border:1px solid #FED7AA; display:flex; align-items:center; justify-content:center;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="3"><path d="M4 12.5l5 5L20 6.5"></path></svg></div>
            <p style="margin:0; font-size:15.5px; line-height:1.68; color:#475569;">Anda sudah membaca artikel, ikut seminar, bahkan mempertimbangkan konsultan pendidikan — tapi <strong style="color:#0B2341;">semua terasa terlalu teoritis</strong> atau terlalu mahal.</p>
          </div>
          <div style="display:flex; gap:18px; padding:22px 0; border-top:1px solid #F1D9BE;">
            <div style="flex:none; width:30px; height:30px; border-radius:8px; background:#FFFFFF; border:1px solid #FED7AA; display:flex; align-items:center; justify-content:center;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="3"><path d="M4 12.5l5 5L20 6.5"></path></svg></div>
            <p style="margin:0; font-size:15.5px; line-height:1.68; color:#475569;">Anda tahu sekolah butuh perubahan — tapi bingung <strong style="color:#0B2341;">apa dulu yang harus dibenahi</strong>: SDM guru, kurikulum, branding, atau infrastruktur?</p>
          </div>
          <div style="display:flex; gap:18px; padding:22px 0; border-top:1px solid #F1D9BE; border-bottom:1px solid #F1D9BE;">
            <div style="flex:none; width:30px; height:30px; border-radius:8px; background:#FFFFFF; border:1px solid #FED7AA; display:flex; align-items:center; justify-content:center;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="3"><path d="M4 12.5l5 5L20 6.5"></path></svg></div>
            <p style="margin:0; font-size:15.5px; line-height:1.68; color:#475569;">Anda ingin sekolah punya <strong style="color:#0B2341;">MoU aktif dengan kampus atau sekolah luar negeri</strong>, tapi tidak tahu bagaimana cara membuka pintu itu secara kredibel.</p>
          </div>
        </div>

        <div class="jt8-callout" style="margin-top:40px; display:flex; flex-wrap:wrap; align-items:center; gap:24px; justify-content:space-between; background:#FFFFFF; border:1px solid #FED7AA; border-left:4px solid #F97316; border-radius:12px; padding:24px 26px;">
          <p style="margin:0; max-width:720px; font-size:16px; line-height:1.65; color:#0B2341; font-weight:600;">Jika salah satu kondisi di atas terasa familiar, yang Anda butuhkan bukan lebih banyak teori — tetapi urutan langkah yang jelas.</p>
          <a href="#materi" style="font-size:14.5px; font-weight:700; color:#C2410C; white-space:nowrap;">Lihat Roadmap yang Akan Dipelajari ↓</a>
        </div>
      </div>
    </section>


    <!-- ============ SECTION FASILITAS PESERTA ============ -->
    <section style="background:#F8FAFC; border-bottom:1px solid #E2E8F0;">
      <div class="jt8-section-pad" style="max-width:1240px; margin:0 auto; padding:clamp(40px,4.5vw,64px) 24px;">
        <div style="max-width:780px;">
          <div style="font-size:12px; font-weight:800; letter-spacing:0.14em; color:#C2410C;">FASILITAS PESERTA</div>
          <h2 style="margin:14px 0 0; font-size:clamp(26px,3vw,38px); line-height:1.2; letter-spacing:-0.02em; font-weight:800; color:#0B2341;">Pengalaman Belajar Interaktif &amp; Resource Eksklusif</h2>
          <p style="margin:16px 0 0; font-size:16.5px; line-height:1.7; color:#475569;">Seluruh peserta—paket Regular maupun Premium—mendapatkan akses ke toolkit eksekusi lengkap berikut:</p>
        </div>

        <div class="jt8-grid-fasilitas" style="margin-top:40px; display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:16px;">
          <div style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:12px; padding:24px; transition:transform 220ms ease, box-shadow 220ms ease;" style-hover="transform:translateY(-3px); box-shadow:0 10px 24px -14px rgba(11,35,65,0.3);">
            <div style="width:38px; height:38px; border-radius:9px; background:#FFF7ED; display:flex; align-items:center; justify-content:center;"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="1.8"><rect x="2" y="6" width="14" height="12" rx="2"></rect><path d="M16 11l6-3v8l-6-3z"></path></svg></div>
            <h3 style="margin:16px 0 0; font-size:16px; font-weight:800; color:#0B2341;">Live Session Bersama Dedi Gunawan</h3>
            <p style="margin:8px 0 0; font-size:14.5px; line-height:1.65; color:#64748B;">Sesi interaktif langsung dengan pemilik 6 sekolah IDN.</p>
          </div>
          <div style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:12px; padding:24px; transition:transform 220ms ease, box-shadow 220ms ease;" style-hover="transform:translateY(-3px); box-shadow:0 10px 24px -14px rgba(11,35,65,0.3);">
            <div style="width:38px; height:38px; border-radius:9px; background:#FFF7ED; display:flex; align-items:center; justify-content:center;"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="1.8"><circle cx="12" cy="12" r="9"></circle><path d="M10 8.5l6 3.5-6 3.5z"></path></svg></div>
            <h3 style="margin:16px 0 0; font-size:16px; font-weight:800; color:#0B2341;">Rekaman Video Full Sesi</h3>
            <p style="margin:8px 0 0; font-size:14.5px; line-height:1.65; color:#64748B;">Akses selama 3 bulan.</p>
          </div>
          <div style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:12px; padding:24px; transition:transform 220ms ease, box-shadow 220ms ease;" style-hover="transform:translateY(-3px); box-shadow:0 10px 24px -14px rgba(11,35,65,0.3);">
            <div style="width:38px; height:38px; border-radius:9px; background:#FFF7ED; display:flex; align-items:center; justify-content:center;"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="1.8"><path d="M6 3h9l4 4v14H6z"></path><path d="M9 12h7M9 16h5"></path></svg></div>
            <h3 style="margin:16px 0 0; font-size:16px; font-weight:800; color:#0B2341;">Lembar Kerja Roadmap Sekolah</h3>
