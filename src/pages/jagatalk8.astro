    }
    .jt8-banner-box {
      padding: 20px 18px !important;
      flex-direction: column !important;
      align-items: flex-start !important;
    }
    .faq-btn {
      padding: 16px 16px !important;
    }
    .faq-panel p {
      padding: 0 16px 16px !important;
    }
  }

  @media (max-width: 360px) {
    .jt8-section-pad {
      padding-left: 12px !important;
      padding-right: 12px !important;
    }
    .jt8-header-container {
      padding: 0 12px !important;
    }
    .jt8-mobile-cta {
      padding: 7px 10px !important;
      font-size: 12px !important;
    }
    .jt8-hero-h1 {
      font-size: 21px !important;
    }
    .jt8-hero-sub-text {
      font-size: 17px !important;
    }
  }
</style>

<script>
  import { getUtm } from '../lib/utm';
  import { lockForm, isFormSubmitted, isPhoneSubmitted } from '../lib/form-guard';
  import { parseIndonesianPhone, formatPhoneInputRealtime } from '../lib/phone-formatter';

  const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwrwCUYnuIUCflczefMlYAHdCnOD-5PMqVEL94QTPWy6Hkds6SiOQLfyo7PZpVoqtjiZg/exec';
  const WA_ADMIN = '628139190363'; // Admin Kamariya

  document.addEventListener('DOMContentLoaded', () => {
    // ── 1. Cek Kuncian Device (1 Device 1 Kali) ──
    const formWrap = document.getElementById('jt8-form-wrap');
    const okArea = document.getElementById('jt8-ok-area');
    const okTitle = document.getElementById('jt8-ok-title');
    const okDesc = document.getElementById('jt8-ok-desc');
    const okBtn = document.getElementById('jt8-ok-btn') as HTMLAnchorElement | null;
    const form = document.getElementById('landing-reg-form') as HTMLFormElement | null;

    if (isFormSubmitted('jagatalk8-form')) {
      if (formWrap) formWrap.style.display = 'none';
      if (okArea) {
        okArea.style.display = 'block';
        if (okTitle) okTitle.textContent = 'Pendaftaran Sudah Terdaftar';
        if (okDesc) okDesc.textContent = 'Terima kasih! Anda sudah mendaftarkan minat pada sesi Jagatalk #8 pada perangkat ini.';
        if (okBtn) {
          okBtn.style.display = 'inline-block';
          okBtn.href = `https://wa.me/${WA_ADMIN}?text=${encodeURIComponent('Halo Admin, saya sebelumnya sudah mendaftar Jagatalk #8, ingin konfirmasi status pendaftaran saya.')}`;
        }
      }
    }

    // ── 2. Toggle Pilihan Paket ──
    let currentPkg = 'Regular';
    const pkgRegBtn = document.getElementById('form-pkg-regular');
    const pkgPremBtn = document.getElementById('form-pkg-premium');

    function selectPkg(pkg: 'Regular' | 'Premium') {
      currentPkg = pkg;
      if (pkgRegBtn && pkgPremBtn) {
        if (pkg === 'Regular') {
          pkgRegBtn.style.background = '#FFF7ED';
          pkgRegBtn.style.borderColor = '#F97316';
          pkgPremBtn.style.background = '#FFFFFF';
          pkgPremBtn.style.borderColor = '#E2E8F0';
        } else {
          pkgPremBtn.style.background = '#FFF7ED';
          pkgPremBtn.style.borderColor = '#F97316';
          pkgRegBtn.style.background = '#FFFFFF';
          pkgRegBtn.style.borderColor = '#E2E8F0';
        }
      }
    }

    pkgRegBtn?.addEventListener('click', () => selectPkg('Regular'));
    pkgPremBtn?.addEventListener('click', () => selectPkg('Premium'));

    // Tombol di pricing section -> scroll to form & set paket
    const pickReg = document.getElementById('btn-pick-regular');
    const pickPrem = document.getElementById('btn-pick-premium');

    pickReg?.addEventListener('click', () => {
      selectPkg('Regular');
      document.getElementById('form')?.scrollIntoView({ behavior: 'smooth' });
    });
    pickPrem?.addEventListener('click', () => {
      selectPkg('Premium');
      document.getElementById('form')?.scrollIntoView({ behavior: 'smooth' });
    });

    // ── 3. Real-time phone formatting ──
    const waInput = document.getElementById('input-wa') as HTMLInputElement | null;
    waInput?.addEventListener('input', () => {
      waInput.value = formatPhoneInputRealtime(waInput.value);
      const errMsg = document.getElementById('form-err-msg');
      if (errMsg) errMsg.style.display = 'none';
    });

    // ── 4. Form Submit Handler (Combo: LocalStorage + WhatsApp) ──
    if (form) {
      const errMsg = document.getElementById('form-err-msg');
      const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const nama = (document.getElementById('input-nama') as HTMLInputElement)?.value.trim() ?? '';
        const lembaga = (document.getElementById('input-lembaga') as HTMLInputElement)?.value.trim() ?? '';
        const rawWa = (document.getElementById('input-wa') as HTMLInputElement)?.value.trim() ?? '';

        if (nama.length < 3) {
          if (errMsg) { errMsg.textContent = 'Mohon isi nama lengkap (minimal 3 karakter).'; errMsg.style.display = 'block'; }
          return;
        }
        if (lembaga.length < 2) {
          if (errMsg) { errMsg.textContent = 'Mohon isi asal lembaga / domisili.'; errMsg.style.display = 'block'; }
          return;
        }

        const parsed = parseIndonesianPhone(rawWa);
        if (!parsed.isValid) {
          if (errMsg) { errMsg.textContent = parsed.error || 'Mohon isi nomor WhatsApp yang valid (contoh: 0812-3456-7890).'; errMsg.style.display = 'block'; }
          return;
        }

        const wa = parsed.e164;
        const isDuplicate = isPhoneSubmitted('jagatalk8-form', wa);

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Mengirim...';
        }

        try {
          await fetch(APPS_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              _sheet: 'LP_Jagatalk8',
              nama,
              nama_lengkap: nama,
              asal_lembaga: lembaga,
              institusi: lembaga,
              domisili: lembaga,
              wa,
              whatsapp: wa,
              paket: currentPkg,
              ...getUtm(),
              source: 'JAGATALK #8 Landing Page (/jagatalk8)',
              timestamp: new Date().toISOString(),
            }),
          });
        } catch (err) {
          console.error('Submit error:', err);
        }

        const win = window as any;
        if (win.fbq) { try { win.fbq('track', 'Lead', { content_name: 'Jagatalk 8' }); } catch (err) { console.error(err); } }

        // Kunci form & simpan nomor WA
        lockForm(form, 'jagatalk8-form', undefined, wa);

        // Teks WhatsApp cerdas (Baru vs Duplikat)
        const greeting = isDuplicate
          ? `Halo Admin, saya ${nama} sebelumnya sudah mendaftar Jagatalk #8 (Paket ${currentPkg}) dengan nomor ini, ingin konfirmasi kelanjutan pendaftaran.`
          : `Halo Admin, saya ${nama} dari ${lembaga} mendaftar Jagatalk #8 (Paket ${currentPkg}). Mohon konfirmasi pembayaran. Terima kasih!`;
        const waUrl = `https://wa.me/${WA_ADMIN}?text=${encodeURIComponent(greeting)}`;

        if (formWrap) formWrap.style.display = 'none';
        if (okArea) {
          okArea.style.display = 'block';
          if (okTitle) okTitle.textContent = isDuplicate ? 'Konfirmasi Terkirim' : 'Pendaftaran Terkirim';
          if (okDesc) okDesc.textContent = 'Mengalihkan ke WhatsApp Admin…';
        }

        setTimeout(() => {
          window.location.href = waUrl;
        }, 600);
      });
    }

    // ── 5. Accordion FAQ Interaktif ──
    const faqBtns = document.querySelectorAll<HTMLButtonElement>('.faq-btn');
    faqBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const panel = item?.querySelector<HTMLElement>('.faq-panel');
        const sign = btn.querySelector<HTMLElement>('.faq-icon-sign');
        if (!panel) return;
        const isOpen = panel.style.display === 'block';
        panel.style.display = isOpen ? 'none' : 'block';
        if (sign) {
          sign.textContent = isOpen ? '+' : '–';
          sign.style.background = isOpen ? '#FFF7ED' : '#F97316';
          sign.style.color = isOpen ? '#C2410C' : '#FFFFFF';
        }
      });
    });
  });
</script>
