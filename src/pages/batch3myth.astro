---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="JAGATRIP #3 — Naikkan Sekolah Anda Bersinergi dengan Kampus Malaysia & Thailand"
  description="Ekspedisi Benchmarking Internasional JAGATRIP #3: kunjungan & kerja sama ke 3 universitas Malaysia & Thailand. 14–18 Desember 2026, 5 hari 4 malam, Rp 7.500.000/pax (Land Only). Slot terbatas."
