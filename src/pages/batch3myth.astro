</BaseLayout>

<script>
  import { getUtm } from '../lib/utm';
  import { initFormGuard, lockForm, isPhoneSubmitted } from '../lib/form-guard';
  import { parseIndonesianPhone } from '../lib/phone-formatter';

  const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwrwCUYnuIUCflczefMlYAHdCnOD-5PMqVEL94QTPWy6Hkds6SiOQLfyo7PZpVoqtjiZg/exec';
  const NOMOR_WA_ADMIN = '628139190363'; // Admin JAGATRIP (0813-9190-363)

  document.addEventListener('DOMContentLoaded', () => {
    // Toggle menu mobile
    const burger = document.getElementById('burger');
    const navlinks = document.getElementById('navlinks');
    burger?.addEventListener('click', () => navlinks?.classList.toggle('open'));
    navlinks?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => navlinks.classList.remove('open')));

    const form = document.getElementById('regForm') as HTMLFormElement | null;
    if (!form) return;
    initFormGuard(form, 'batch3myth-form', '✓ Pendaftaran Anda sudah terkirim. Tim JAGATRIP akan menghubungi Anda.');
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const statusEl = document.getElementById('regStatus');

    function showStatus(type: 'ok' | 'err', msg: string): void {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.className = `reg-status ${type}`;
      statusEl.hidden = false;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const nama = (form.querySelector('#nama') as HTMLInputElement | null)?.value.trim() ?? '';
      const domisili = (form.querySelector('#domisili') as HTMLInputElement | null)?.value.trim() ?? '';
      const rawWa = (form.querySelector('#wa') as HTMLInputElement | null)?.value.trim() ?? '';
      if (!nama || !domisili || !rawWa) { showStatus('err', 'Semua field wajib diisi.'); return; }

      const parsedPhone = parseIndonesianPhone(rawWa);
      const wa = parsedPhone.e164 || rawWa;
      const isDuplicate = isPhoneSubmitted('batch3myth-form', wa);

      if (btn) { btn.disabled = true; btn.textContent = 'Memproses...'; }

      try {
        await fetch(APPS_SCRIPT_URL, {
          method: 'POST', mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            _sheet: 'Batch3MYTH', nama, domisili, wa,
            ...getUtm(), source: 'LP /batch3myth', timestamp: new Date().toISOString(),
          }),
        });
      } catch (err) { console.error('Log lead error:', err); }

      const win = window as any;
      if (win.fbq) { try { win.fbq('track', 'Lead', { content_name: 'Batch3 MY-TH' }); } catch (e) { console.error(e); } }

      const pesan = isDuplicate
        ? `Halo Admin JAGATRIP, saya sebelumnya sudah mendaftar JAGATRIP #3 (Malaysia–Thailand) dengan nomor ini, ingin konfirmasi status pendaftaran saya.\n\nNama Lengkap: ${nama}\nDomisili: ${domisili}\nNo. WhatsApp: ${wa}`
        : `Halo Admin JAGATRIP, saya ingin mendaftar JAGATRIP #3 (Malaysia–Thailand, 14–18 Des 2026).\n\nNama Lengkap: ${nama}\nDomisili: ${domisili}\nNo. WhatsApp: ${wa}`;
      const waUrl = `https://wa.me/${NOMOR_WA_ADMIN}?text=${encodeURIComponent(pesan)}`;
      showStatus('ok', isDuplicate ? 'Sudah terdaftar sebelumnya. Mengalihkan ke WhatsApp...' : 'Pendaftaran berhasil! Mengalihkan ke WhatsApp...');
      lockForm(form, 'batch3myth-form', isDuplicate ? '✓ Anda sudah terdaftar sebelumnya.' : '✓ Pendaftaran berhasil terkirim.', wa);
      setTimeout(() => { window.location.href = waUrl; }, 500);
    });
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap');

  :global(body){margin:0;background:#fff}
  .b3{
    --orange:#FF6B35;--orange-dark:#E4551F;--orange-soft:#FFEDE3;--cream:#FAF2F7;
    --navy:#16233B;--navy-2:#22354F;--ink:#1B2430;--muted:#5E6B7A;--line:#EADFE7;--white:#fff;
    --shadow:0 12px 34px rgba(22,35,59,.12);--radius:16px;
    font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--ink);line-height:1.55;display:block
  }
  .b3 *{box-sizing:border-box}
  .b3 h1,.b3 h2,.b3 h3,.b3 h4{font-family:'Poppins',sans-serif;line-height:1.18;color:var(--navy);margin:0}
  .b3 a{text-decoration:none;color:inherit}
  .b3 p{margin:0}
  .b3 ul{margin:0;padding:0}
