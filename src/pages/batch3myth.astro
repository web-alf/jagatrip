  ogType="website"
>
  <div class="b3" id="main">
    <!-- NAV -->
    <header class="nav">
      <div class="b3wrap nav-inner">
        <div class="brand">
          <svg class="mark" viewBox="0 0 100 112" aria-hidden="true"><path d="M50,30 C43,18 30,12 18,14 C13,15 12,18 12,24 L12,54 C12,80 32,98 50,106 C68,98 88,80 88,54 L88,24 C88,18 87,15 82,14 C70,12 57,18 50,30 Z" fill="#fff" stroke="#FF6B35" stroke-width="13" stroke-linejoin="round"/><circle cx="50" cy="58" r="12.5" fill="#FF6B35"/></svg>
          <b>jaga<span>trip</span></b>
        </div>
        <nav class="nav-links" id="navlinks" aria-label="Navigasi utama">
          <a href="#masalah">Realita</a>
          <a href="#program">Program</a>
          <a href="#itinerary">Itinerary</a>
